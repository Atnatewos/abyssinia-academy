{
  "name": "abyssinia-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Abyssinia Tech Academy - Full-Stack LMS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "db:migrate": "node tools/migrate.js",
    "db:seed": "node tools/seed.js",
    "vercel-build": "cd apps/web && npm install && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}