{
  "name": "abyssinia-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Abyssinia Tech Academy - Full-Stack LMS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=apps/api",
    "db:migrate": "node tools/migrate.js",
    "db:seed": "node tools/seed.js",
    "db:backup": "node tools/backup.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint apps packages --ext .js,.jsx",
    "format": "prettier --write \"**/*.{js,jsx,css,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "prettier": "^3.2.4"
  }
}
