/**
 * Abyssinia Academy - Component Styles
 * Complete component-level styles matching Gemini foundation
 * Path: apps/web/styles/components.css
 */

/* ============================================================================
   PAGE LAYOUT
   ============================================================================ */

.page-wrapper {
  min-height: 100vh;
  font-family: var(--font-primary);
  transition: background-color 0.3s ease, color 0.3s ease;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-x: hidden;
  background-color: var(--bg-main);
  color: var(--text-main);
}

.page-wrapper.light {
  background-color: var(--text-main);
  color: #0f172a;
}

/* ============================================================================
   TOP BANNER
   ============================================================================ */

.top-banner {
  background: linear-gradient(90deg, #d97706 0%, #f59e0b 50%, #b45309 100%);
  color: #0f172a;
  font-weight: 600;
  font-size: 0.75rem;
  padding: 0.5rem 1rem;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  z-index: 50;
  position: relative;
}

@media (min-width: 640px) {
  .top-banner {
    font-size: 0.875rem;
  }
}

.top-banner-link {
  text-decoration: underline;
  margin-left: 0.5rem;
  color: #0f172a;
  font-weight: 700;
  transition: color 0.2s ease;
}

.top-banner-link:hover {
  color: #ffffff;
}

/* ==========================================================================
   NAVIGATION — Premium Sticky Header (Theme-Aware)
   ========================================================================== */

.nav-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--bg-nav);
  backdrop-filter: blur(var(--nav-glass-blur)) saturate(160%);
  -webkit-backdrop-filter: blur(var(--nav-glass-blur)) saturate(160%);
  border-bottom: 1px solid var(--border-nav);
  padding: 0 1.25rem;
  height: var(--nav-height);
  display: flex;
  align-items: center;
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav-header.nav-scrolled {
  background: var(--bg-nav-scrolled);
  border-bottom-color: var(--border-nav-scrolled);
  box-shadow: var(--shadow-nav);
}

@media (min-width: 1024px) {
  .nav-header {
    padding: 0 2.5rem;
  }
}

/* ── Inner Container ── */
.nav-inner {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1.25rem;
}

/* ── Logo ── */
.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: inherit;
  flex-shrink: 0;
}

.nav-logo-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--accent-gold-light), var(--accent-gold), var(--accent-gold-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 12px var(--accent-gold-glow);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.nav-logo:hover .nav-logo-icon {
  transform: scale(1.08);
}

.nav-logo-icon svg {
  width: 22px;
  height: 22px;
  color: #0f172a;
}

.nav-logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1;
}

.nav-logo-name {
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--text-main);
}

.nav-logo-suffix {
  font-size: 0.625rem;
  letter-spacing: 0.12em;
  color: var(--text-dim);
  font-weight: 500;
  text-transform: uppercase;
  margin-top: 1px;
}

/* ── Desktop Navigation Pills ── */
.nav-pills {
  display: none;
  align-items: center;
  gap: 0.25rem;
  background: var(--bg-pill-container);
  padding: 0.35rem;
  border-radius: 9999px;
  border: 1px solid var(--border-pill);
}

@media (min-width: 768px) {
  .nav-pills {
    display: flex;
  }
}

.nav-pill {
  position: relative;
  padding: 0.55rem 1.35rem;
  border-radius: 9999px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-nav-link);
  text-decoration: none;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  border: none;
  background: transparent;
  cursor: pointer;
  letter-spacing: 0.01em;
}

.nav-pill:hover {
  color: var(--text-nav-link-hover);
  background: var(--bg-ghost-hover);
}

.nav-pill.active {
  background: var(--accent-gold);
  color: #0f172a;
  font-weight: 650;
  box-shadow: 0 2px 14px var(--accent-gold-glow);
  transform: scale(1.04);
}

.nav-pill-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  margin-left: 0.4rem;
  vertical-align: middle;
  animation: nav-dot-pulse 2s ease-in-out infinite;
}

@keyframes nav-dot-pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
  50% { opacity: 0.5; box-shadow: 0 0 0 5px rgba(16, 185, 129, 0); }
}

/* ── Controls Group ── */
.nav-controls {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  flex-shrink: 0;
}

@media (min-width: 640px) {
  .nav-controls {
    gap: 0.5rem;
  }
}

/* ── Icon Button (language, theme, referrals) ── */
.nav-icon-btn {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.45rem 0.6rem;
  border-radius: 9px;
  background: transparent;
  color: var(--text-nav-icon);
  font-size: 0.78rem;
  font-weight: 550;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  text-decoration: none;
}

.nav-icon-btn:hover {
  background: var(--bg-icon-btn-hover);
  color: var(--text-nav-icon-hover);
}

.nav-icon-btn svg {
  width: 17px;
  height: 17px;
}

.nav-icon-label {
  display: none;
}

@media (min-width: 768px) {
  .nav-icon-label {
    display: inline;
  }
}

.nav-theme-btn {
  padding: 0.45rem;
  border-radius: 9px;
}

/* ── Auth Group ── */
.nav-auth-group {
  display: none;
  align-items: center;
  gap: 0.35rem;
}

@media (min-width: 768px) {
  .nav-auth-group {
    display: flex;
  }
}

/* ── Enrolled Badge ── */
.nav-enrolled-badge {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.25rem 0.7rem 0.25rem 0.25rem;
  border-radius: 9999px;
  background: var(--bg-badge);
  border: 1px solid var(--border-badge);
}

.nav-enrolled-dot {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.nav-enrolled-dot::after {
  content: '';
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #10b981;
  animation: nav-dot-pulse 2s ease-in-out infinite;
}

.nav-enrolled-label {
  font-size: 0.72rem;
  font-weight: 600;
  color: #10b981;
  letter-spacing: 0.02em;
}

/* ── Profile Button ── */
.nav-profile-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.25rem 0.65rem 0.25rem 0.25rem;
  border-radius: 9999px;
  background: transparent;
  color: var(--text-nav-icon);
  font-size: 0.8rem;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s ease;
}

.nav-profile-btn:hover {
  background: var(--bg-icon-btn-hover);
  color: var(--text-nav-icon-hover);
}

.nav-profile-avatar {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-gold), var(--accent-gold-dark));
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  font-weight: 700;
}

.nav-profile-name {
  display: none;
}

@media (min-width: 1024px) {
  .nav-profile-name {
    display: inline;
  }
}

/* ── Logout Button ── */
.nav-logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  border-radius: 9px;
  background: transparent;
  color: var(--text-dim);
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.nav-logout-btn svg {
  width: 17px;
  height: 17px;
}

.nav-logout-btn:hover {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

/* ── Enroll Now CTA ── */
.nav-enroll-btn {
  position: relative;
  overflow: hidden;
  border-radius: 9999px;
  padding: 1px;
  font-weight: 600;
  font-size: 0.8rem;
  display: none;
  text-decoration: none;
}

@media (min-width: 640px) {
  .nav-enroll-btn {
    display: block;
  }
}

.nav-enroll-btn-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, var(--accent-gold), var(--accent-gold-light), var(--accent-gold-dark), var(--accent-gold));
  background-size: 300% 100%;
  border-radius: 9999px;
  animation: gradient-shift 4s ease infinite;
}

@keyframes gradient-shift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.nav-enroll-btn-text {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.55rem 1.1rem;
  border-radius: 9999px;
  background: var(--bg-main);
  color: var(--accent-gold-light);
  font-weight: 700;
  transition: all 0.3s ease;
}

.nav-enroll-btn-text svg {
  width: 16px;
  height: 16px;
}

.nav-enroll-btn:hover .nav-enroll-btn-text {
  background: transparent;
  color: #0f172a;
}

/* ── Mobile Toggle ── */
.nav-mobile-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 9px;
  background: transparent;
  color: var(--text-nav-icon);
  border: 1px solid var(--border-pill);
  cursor: pointer;
  transition: all 0.2s ease;
}

.nav-mobile-toggle svg {
  width: 20px;
  height: 20px;
}

.nav-mobile-toggle:hover {
  background: var(--bg-icon-btn-hover);
  color: var(--text-nav-icon-hover);
}

@media (min-width: 768px) {
  .nav-mobile-toggle {
    display: none;
  }
}

/* ── Mobile Menu ── */
.nav-mobile-menu {
  position: absolute;
  top: var(--nav-height);
  left: 0;
  right: 0;
  padding: 1.5rem 1.25rem 1.75rem;
  background: var(--bg-mobile-menu);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border-mobile-link);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  animation: mobile-slide-down 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 49;
}

@keyframes mobile-slide-down {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (min-width: 768px) {
  .nav-mobile-menu {
    display: none;
  }
}

.nav-mobile-link {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  padding: 0.9rem 1.1rem;
  border-radius: 11px;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--text-nav-link);
  text-decoration: none;
  transition: all 0.2s ease;
}

.nav-mobile-link:hover {
  background: var(--bg-ghost-hover);
  color: var(--text-nav-link-hover);
}

.nav-mobile-link.active {
  background: rgba(245, 158, 11, 0.12);
  color: var(--accent-gold);
  font-weight: 600;
}

.nav-mobile-divider {
  height: 1px;
  background: var(--border-mobile-link);
  margin: 0.6rem 0;
}

.nav-mobile-logout {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  width: 100%;
  padding: 0.9rem 1.1rem;
  border-radius: 11px;
  font-size: 0.95rem;
  font-weight: 500;
  background: transparent;
  color: #ef4444;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-top: 0.25rem;
}

.nav-mobile-logout:hover {
  background: rgba(239, 68, 68, 0.08);
}

.nav-mobile-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.95rem 1.75rem;
  border-radius: 9999px;
  background: var(--accent-gold);
  color: #0f172a;
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
  margin-top: 0.85rem;
}

/* ============================================================================
   HERO SECTION
   ============================================================================ */

.hero-section {
  position: relative;
  padding-top: 2.5rem;
  padding-left: 1rem;
  padding-right: 1rem;
  max-width: 1280px;
  margin: 0 auto;
}

@media (min-width: 1024px) {
  .hero-section {
    padding-top: 4rem;
  }
}

.hero-grid {
  display: grid;
  gap: 3rem;
  align-items: center;
}

@media (min-width: 1024px) {
  .hero-grid {
    grid-template-columns: 7fr 5fr;
  }
}

.hero-content {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  text-align: center;
}

@media (min-width: 1024px) {
  .hero-content {
    text-align: left;
  }
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-gold);
  border: 1px solid rgba(245, 158, 11, 0.3);
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

@media (min-width: 640px) {
  .hero-badge {
    font-size: 0.875rem;
  }
}

.hero-badge svg {
  width: 1rem;
  height: 1rem;
  color: var(--accent-gold);
  fill: var(--accent-gold);
  animation: bounce 1.5s ease-in-out infinite;
}

.hero-title {
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

@media (min-width: 640px) {
  .hero-title {
    font-size: 3.75rem;
  }
}

@media (min-width: 1024px) {
  .hero-title {
    font-size: 4.5rem;
  }
}

.hero-subtitle {
  font-size: 1.125rem;
  color: var(--text-muted);
  max-width: 42rem;
  line-height: 1.6;
}

@media (min-width: 640px) {
  .hero-subtitle {
    font-size: 1.25rem;
  }
}

.hero-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding-top: 0.5rem;
}

@media (min-width: 640px) {
  .hero-actions {
    flex-direction: row;
    justify-content: center;
  }
}

@media (min-width: 1024px) {
  .hero-actions {
    justify-content: flex-start;
  }
}

/* ============================================================================
   HERO VISUAL CARD
   ============================================================================ */

.hero-visual {
  position: relative;
}

.hero-visual-card {
  position: relative;
  z-index: 10;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: 1.5rem;
  padding: 1.5rem;
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  animation: float 5s ease-in-out infinite;
}

.hero-visual-titlebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border-medium);
  margin-bottom: 1rem;
}

.hero-visual-dots {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.hero-visual-dot {
  width: 0.75rem;
  height: 0.75rem;
  border-radius: 9999px;
}

.hero-visual-dot.red { background: #ef4444; }
.hero-visual-dot.yellow { background: #eab308; }
.hero-visual-dot.green { background: #22c55e; }

.hero-visual-filename {
  font-size: 0.75rem;
  font-family: var(--font-mono);
  color: var(--text-dim);
}

.hero-visual-preview {
  position: relative;
  aspect-ratio: 16 / 9;
  border-radius: 0.75rem;
  overflow: hidden;
  background: var(--bg-main);
  border: 1px solid var(--bg-pill);
  cursor: pointer;
  margin-bottom: 1rem;
}

.hero-visual-preview img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.6;
  transition: transform 0.5s ease;
}

.hero-visual-preview:hover img {
  transform: scale(1.05);
}

.hero-visual-preview-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, var(--bg-main), rgba(2, 6, 23, 0.4), transparent);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-visual-play-btn {
  width: 4rem;
  height: 4rem;
  border-radius: 9999px;
  background: var(--accent-gold);
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  transition: transform 0.3s ease;
  border: none;
  cursor: pointer;
}

.hero-visual-play-btn:hover {
  transform: scale(1.1);
}

.hero-visual-play-btn svg {
  width: 2rem;
  height: 2rem;
  fill: currentColor;
  margin-left: 0.25rem;
}

.hero-visual-info {
  position: absolute;
  bottom: 0.75rem;
  left: 0.75rem;
  right: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.75rem;
  color: var(--text-secondary);
  background: rgba(15, 23, 42, 0.8);
  backdrop-filter: blur(8px);
  padding: 0.375rem 0.75rem;
  border-radius: 0.5rem;
  border: 1px solid var(--bg-pill);
}

.hero-visual-sessions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
}

.hero-visual-session {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.625rem;
  border-radius: 0.5rem;
  border: 1px solid var(--border-medium);
  background: var(--bg-card);
}

.dark .hero-visual-session {
  background: var(--bg-card);
}

.hero-visual-session.active {
  color: var(--accent-gold);
  font-weight: 600;
}

.hero-visual-session.inactive {
  color: var(--text-dim);
}

.hero-visual-session-time {
  color: var(--text-dim);
}

/* ============================================================================
   STATS BAR
   ============================================================================ */

.stats-bar {
  padding-top: 1.5rem;
  border-top: 1px solid var(--border-medium);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  text-align: center;
}

@media (min-width: 1024px) {
  .stats-bar {
    text-align: left;
  }
}

.stats-value {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--accent-gold);
}

@media (min-width: 640px) {
  .stats-value {
    font-size: 1.875rem;
  }
}

.stats-label {
  font-size: 0.75rem;
  color: var(--text-dim);
  font-weight: 500;
}

/* ============================================================================
   SECTION HEADERS
   ============================================================================ */

.section-header {
  text-align: center;
  max-width: 48rem;
  margin: 0 auto;
}

.section-tag {
  font-size: 0.75rem;
  text-transform: uppercase;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--accent-gold);
  margin-bottom: 0.75rem;
}

.section-title {
  font-size: 1.875rem;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin-bottom: 0.75rem;
}

@media (min-width: 640px) {
  .section-title {
    font-size: 3rem;
  }
}

.section-subtitle {
  font-size: 1rem;
  color: var(--text-muted);
}

/* ============================================================================
   FEATURE CARDS
   ============================================================================ */

.features-grid {
  display: grid;
  gap: 1.5rem;
}

@media (min-width: 768px) {
  .features-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .features-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.feature-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-main);
  border-radius: 1.5rem;
  padding: 1.5rem;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.feature-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-hover);
  box-shadow: 0 20px 35px -10px var(--glow-color);
}

.feature-card-icon {
  width: 3rem;
  height: 3rem;
  border-radius: 1rem;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-gold);
  margin-bottom: 1rem;
}

.feature-card-icon svg {
  width: 1.5rem;
  height: 1.5rem;
}

.feature-card-title {
  font-size: 1.25rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
  color: var(--text-main);
}

.feature-card-desc {
  font-size: 0.75rem;
  color: var(--text-muted);
  line-height: 1.6;
}

/* ============================================================================
   STEP CARDS (How It Works)
   ============================================================================ */

.steps-grid {
  display: grid;
  gap: 1.5rem;
}

@media (min-width: 768px) {
  .steps-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .steps-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.step-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1.5rem;
  padding: 1.5rem;
  position: relative;
}

.step-number {
  font-size: 2.5rem;
  font-weight: 800;
  font-family: var(--font-mono);
  color: rgba(245, 158, 11, 0.3);
  display: block;
  margin-bottom: 0.5rem;
}

.step-title {
  font-size: 1.125rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
  color: var(--text-main);
}

.step-desc {
  font-size: 0.75rem;
  color: var(--text-muted);
  line-height: 1.6;
}

/* ============================================================================
   FAQ ACCORDION
   ============================================================================ */

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.faq-item {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  overflow: hidden;
  transition: all 0.3s ease;
}

.faq-question {
  width: 100%;
  padding: 1.25rem;
  text-align: left;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
  font-size: 0.875rem;
  gap: 1rem;
  background: none;
  border: none;
  color: var(--text-main);
  cursor: pointer;
}

@media (min-width: 640px) {
  .faq-question {
    font-size: 1rem;
  }
}

.faq-chevron {
  width: 1.25rem;
  height: 1.25rem;
  color: var(--accent-gold);
  flex-shrink: 0;
  transition: transform 0.3s ease;
}

.faq-chevron.open {
  transform: rotate(180deg);
}

.faq-answer-wrapper {
  display: grid;
  transition: all 0.3s ease-in-out;
}

.faq-answer-wrapper.open {
  grid-template-rows: 1fr;
  opacity: 1;
}

.faq-answer-wrapper.closed {
  grid-template-rows: 0fr;
  opacity: 0;
}

.faq-answer-inner {
  overflow: hidden;
}

.faq-answer-text {
  padding: 0 1.25rem 1.25rem;
  font-size: 0.75rem;
  color: var(--text-muted);
  line-height: 1.6;
  border-top: 1px solid var(--border-medium);
  padding-top: 0.75rem;
  margin: 0 1.25rem;
}

@media (min-width: 640px) {
  .faq-answer-text {
    font-size: 0.875rem;
  }
}

/* ============================================================================
   CTA BANNER
   ============================================================================ */

.cta-banner {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.4);
  border-radius: 1.5rem;
  padding: 2rem;
  text-align: center;
  position: relative;
  overflow: hidden;
}

@media (min-width: 640px) {
  .cta-banner {
    padding: 3rem;
  }
}

.cta-glow {
  position: absolute;
  top: -2.5rem;
  right: -2.5rem;
  width: 10rem;
  height: 10rem;
  background: rgba(245, 158, 11, 0.2);
  border-radius: 9999px;
  filter: blur(3rem);
}

.cta-title {
  font-size: 1.875rem;
  font-weight: 800;
  margin-bottom: 1rem;
}

@media (min-width: 640px) {
  .cta-title {
    font-size: 3rem;
  }
}

.cta-subtitle {
  font-size: 0.875rem;
  color: var(--text-muted);
  max-width: 42rem;
  margin: 0 auto 1.5rem;
}

@media (min-width: 640px) {
  .cta-subtitle {
    font-size: 1rem;
  }
}

/* ============================================================================
   COURSE CARD
   ============================================================================ */

.courses-grid {
  display: grid;
  gap: 2rem;
}

@media (min-width: 768px) {
  .courses-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.course-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: 1.5rem;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
}

.course-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-hover);
  box-shadow: 0 20px 35px -10px var(--glow-color);
}

.course-card-top {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.course-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-card-badge {
  padding: 0.375rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 700;
  background: rgba(245, 158, 11, 0.1);
  color: var(--accent-gold);
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.course-card-duration {
  font-size: 0.75rem;
  font-family: var(--font-mono);
  color: var(--text-dim);
}

.course-card-icon {
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 1rem;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-gold);
  transition: transform 0.3s ease;
}

.course-card:hover .course-card-icon {
  transform: scale(1.1);
}

.course-card-icon svg {
  width: 1.75rem;
  height: 1.75rem;
}

.course-card-title {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 0.5rem;
  transition: color 0.2s ease;
}

.course-card:hover .course-card-title {
  color: var(--accent-gold);
}

.course-card-desc {
  font-size: 0.875rem;
  color: var(--text-muted);
  line-height: 1.6;
}

.course-card-bottom {
  padding-top: 2rem;
  margin-top: 1.5rem;
  border-top: 1px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-card-level {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-gold);
}

.course-card-btn {
  padding: 0.625rem 1.25rem;
  border-radius: 0.75rem;
  background: var(--accent-gold);
  color: #0f172a;
  font-weight: 800;
  font-size: 0.75rem;
  transition: background 0.2s ease;
  display: flex;
  align-items: center;
  gap: 0.375rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
}

.course-card-btn:hover {
  background: #fbbf24;
}

.course-card-btn svg {
  width: 1rem;
  height: 1rem;
}

/* ============================================================================
   PHASE CARD
   ============================================================================ */

.phases-grid {
  display: grid;
  gap: 2rem;
}

@media (min-width: 768px) {
  .phases-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .phases-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.phase-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: 1.5rem;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.phase-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-hover);
  box-shadow: 0 20px 35px -10px var(--glow-color);
}

.phase-card-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 0.375rem;
}

.phase-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
  padding-top: 0.25rem;
}

.phase-card-number {
  padding: 0.375rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 700;
  background: rgba(245, 158, 11, 0.1);
  color: var(--accent-gold);
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.phase-card-duration {
  font-size: 0.75rem;
  font-family: var(--font-mono);
  color: var(--text-dim);
  font-weight: 600;
}

.phase-card-icon {
  width: 3rem;
  height: 3rem;
  border-radius: 1rem;
  background: var(--bg-pill);
  border: 1px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-gold);
  margin-bottom: 1rem;
  transition: transform 0.3s ease;
}

.phase-card:hover .phase-card-icon {
  transform: scale(1.1);
}

.phase-card-icon svg {
  width: 1.5rem;
  height: 1.5rem;
}

.phase-card-title {
  font-size: 1.25rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
  color: var(--text-main);
  transition: color 0.2s ease;
}

.phase-card:hover .phase-card-title {
  color: var(--accent-gold);
}

.phase-card-subtitle {
  font-size: 0.75rem;
  font-weight: 600;
  color: rgba(245, 158, 11, 0.9);
  margin-bottom: 0.75rem;
}

.phase-card-desc {
  font-size: 0.75rem;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 1.5rem;
}

.phase-card-outcomes {
  padding: 1rem;
  border-radius: 1rem;
  background: var(--bg-input);
  border: 1px solid var(--border-medium);
  margin-bottom: 1.5rem;
}

.phase-card-outcomes-label {
  font-size: 0.625rem;
  text-transform: uppercase;
  font-weight: 800;
  color: var(--accent-gold);
  letter-spacing: 0.05em;
  display: block;
  margin-bottom: 0.5rem;
}

.phase-card-outcomes-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.phase-card-outcome {
  font-size: 0.688rem;
  color: var(--text-muted);
  display: flex;
  align-items: flex-start;
  gap: 0.375rem;
}

.phase-card-outcome svg {
  width: 0.875rem;
  height: 0.875rem;
  color: var(--accent-gold);
  flex-shrink: 0;
  margin-top: 0.125rem;
}

.phase-card-bottom {
  padding-top: 1rem;
  border-top: 1px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.phase-card-module {
  font-size: 0.75rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
}

.phase-card-btn {
  padding: 0.5rem 1rem;
  border-radius: 0.75rem;
  background: var(--accent-gold);
  color: #0f172a;
  font-weight: 700;
  font-size: 0.75rem;
  transition: background 0.2s ease;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  text-decoration: none;
  border: none;
  cursor: pointer;
}

.phase-card-btn:hover {
  background: #fbbf24;
}

.phase-card-btn svg {
  width: 1rem;
  height: 1rem;
}

/* ============================================================================
   BACK BUTTON
   ============================================================================ */

.back-btn {
  padding: 0.5rem 1rem;
  border-radius: 0.75rem;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-gold);
  border: 1px solid rgba(245, 158, 11, 0.3);
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: all 0.2s ease;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.back-btn:hover {
  background: var(--accent-gold);
  color: #0f172a;
}

/* ============================================================================
   PORTAL LAYOUT
   ============================================================================ */

.portal-header {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  padding: 1rem;
}

@media (min-width: 640px) {
  .portal-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.portal-header-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.portal-header-icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 0.75rem;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-gold);
}

.portal-header-icon svg {
  width: 1.25rem;
  height: 1.25rem;
}

.portal-header-title {
  font-weight: 800;
  font-size: 1rem;
  color: var(--text-main);
}

@media (min-width: 640px) {
  .portal-header-title {
    font-size: 1.125rem;
  }
}

.portal-header-subtitle {
  font-size: 0.75rem;
  color: var(--text-dim);
}

.portal-grid {
  display: grid;
  gap: 1.5rem;
}

@media (min-width: 1024px) {
  .portal-grid {
    grid-template-columns: 8fr 4fr;
  }
}

/* ============================================================================
   VIDEO PLAYER
   ============================================================================ */

.video-player {
  position: relative;
  aspect-ratio: 16 / 9;
  border-radius: 1rem;
  overflow: hidden;
  background: var(--bg-main);
  border: 1px solid var(--bg-pill);
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
}

.video-player iframe {
  width: 100%;
  height: 100%;
  border: none;
}

.video-locked-overlay {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.9);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  text-align: center;
  z-index: 20;
}

.video-locked-icon {
  width: 4rem;
  height: 4rem;
  border-radius: 1rem;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-gold);
  margin-bottom: 1rem;
  animation: pulse 2s ease-in-out infinite;
}

.video-locked-icon svg {
  width: 2rem;
  height: 2rem;
}

.video-locked-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 0.5rem;
}

.video-locked-desc {
  font-size: 0.75rem;
  color: var(--text-dim);
  max-width: 28rem;
}

.video-locked-btn {
  margin-top: 1rem;
  padding: 0.75rem 1.5rem;
  border-radius: 0.75rem;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #0f172a;
  font-weight: 800;
  font-size: 0.75rem;
  border: none;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease;
}

.video-locked-btn:hover {
  transform: scale(1.05);
}

/* ============================================================================
   LESSON DETAILS
   ============================================================================ */

.lesson-details {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  padding: 1.5rem;
}

.lesson-details-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.lesson-details-label {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.lesson-details-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--text-main);
}

@media (min-width: 640px) {
  .lesson-details-title {
    font-size: 1.5rem;
  }
}

/* ============================================================================
   COMPLETE BUTTON
   ============================================================================ */

.complete-btn {
  padding: 0.5rem 1rem;
  border-radius: 0.75rem;
  font-size: 0.75rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  transition: all 0.2s ease;
  border: none;
  cursor: pointer;
}

.complete-btn.incomplete {
  background: var(--text-secondary);
  color: var(--text-muted);
}

.dark .complete-btn.incomplete {
  background: var(--bg-pill);
  color: var(--text-muted);
}

.complete-btn.incomplete:hover {
  background: var(--text-muted);
}

.dark .complete-btn.incomplete:hover {
  background: var(--text-muted);
}

.complete-btn.completed {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.4);
}

.complete-btn.completed:hover {
  background: rgba(16, 185, 129, 0.25);
}

.complete-btn svg {
  width: 1rem;
  height: 1rem;
}

.complete-btn.completed svg {
  fill: #10b981;
}

/* ============================================================================
   LESSON TABS
   ============================================================================ */

.lesson-tabs {
  border-top: 1px solid var(--border-medium);
  padding-top: 1rem;
  margin-top: 1rem;
}

.lesson-tabs-nav {
  display: flex;
  align-items: center;
  gap: 1rem;
  border-bottom: 1px solid var(--border-medium);
  padding-bottom: 0.5rem;
  margin-bottom: 1rem;
}

.lesson-tab {
  font-size: 0.75rem;
  font-weight: 700;
  padding-bottom: 0.5rem;
  transition: all 0.2s ease;
  border-bottom: 2px solid transparent;
  background: none;
  border-top: none;
  border-left: none;
  border-right: none;
  color: var(--text-dim);
  cursor: pointer;
}

.lesson-tab:hover {
  color: var(--accent-gold);
}

.lesson-tab.active {
  border-bottom-color: var(--accent-gold);
  color: var(--accent-gold);
}

/* ============================================================================
   SESSION LIST
   ============================================================================ */

.session-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border-medium);
  font-size: 0.75rem;
}

.session-name {
  font-weight: 600;
  color: var(--text-secondary);
}

.session-time {
  font-family: var(--font-mono);
  color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.1);
  padding: 0.25rem 0.625rem;
  border-radius: 0.375rem;
}

/* ============================================================================
   RESOURCE DOWNLOAD
   ============================================================================ */

.resource-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.resource-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border-medium);
  font-size: 0.75rem;
}

.resource-name {
  font-family: var(--font-mono);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.resource-name svg {
  width: 1rem;
  height: 1rem;
  color: var(--accent-gold);
}

.resource-download-btn {
  color: var(--accent-gold);
  font-size: 0.75rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  background: none;
  border: none;
  cursor: pointer;
}

.resource-download-btn:hover {
  text-decoration: underline;
}

.resource-download-btn svg {
  width: 0.875rem;
  height: 0.875rem;
}

/* ============================================================================
   LESSON NOTES
   ============================================================================ */

.lesson-notes {
  font-size: 0.75rem;
  color: var(--text-muted);
  background: var(--bg-input);
  padding: 1rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border-medium);
  line-height: 1.6;
}

/* ============================================================================
   CURRICULUM SIDEBAR
   ============================================================================ */

.curriculum-sidebar {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  height: 650px;
}

.curriculum-title {
  font-weight: 800;
  font-size: 0.875rem;
  color: var(--text-secondary);
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.curriculum-count {
  font-size: 0.75rem;
  font-family: var(--font-mono);
  color: var(--accent-gold);
}

.curriculum-list {
  flex: 1;
  overflow-y: auto;
  padding-right: 0.25rem;
  margin-top: 0.75rem;
}

.curriculum-phase {
  font-size: 0.688rem;
  font-weight: 700;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0.5rem;
  padding-top: 0.5rem;
}

.curriculum-week {
  font-size: 0.625rem;
  font-weight: 600;
  color: var(--text-dim);
  padding: 0.25rem 0.5rem;
}

.curriculum-lesson {
  padding: 0.75rem;
  border-radius: 0.75rem;
  font-size: 0.75rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid transparent;
  background: var(--bg-card);
  color: var(--text-muted);
  margin-bottom: 0.25rem;
}

.curriculum-lesson:hover {
  background: var(--bg-pill);
}

.curriculum-lesson.active {
  background: rgba(245, 158, 11, 0.15);
  border-color: rgba(245, 158, 11, 0.5);
  color: var(--text-main);
  font-weight: 700;
}

.curriculum-lesson-left {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  overflow: hidden;
}

.curriculum-lesson-left svg {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
}

.curriculum-lesson-left .icon-completed {
  color: #10b981;
}

.curriculum-lesson-left .icon-locked {
  color: var(--text-dim);
}

.curriculum-lesson-left .icon-play {
  color: var(--accent-gold);
}

.curriculum-lesson-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.curriculum-lesson-duration {
  font-size: 0.625rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
  flex-shrink: 0;
  margin-left: 0.5rem;
}

/* ============================================================================
   PROGRESS BAR
   ============================================================================ */

.progress-bar-wrapper {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: var(--bg-input);
  padding: 0.5rem 1rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border-medium);
}

.progress-bar-text {
  text-align: right;
}

.progress-bar-label {
  font-size: 0.75rem;
  color: var(--text-dim);
  font-weight: 500;
}

.progress-bar-percent {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-gold);
}

.progress-bar-track {
  width: 7rem;
  height: 0.625rem;
  border-radius: 9999px;
  background: var(--text-muted);
  overflow: hidden;
}

.dark .progress-bar-track {
  background: var(--bg-pill);
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #fde68a);
  transition: width 0.5s ease;
}

/* ============================================================================
   PRICING CARD
   ============================================================================ */

.pricing-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.4);
  border-radius: 1.5rem;
  padding: 2rem;
  position: relative;
  overflow: hidden;
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  max-width: 28rem;
  margin: 0 auto;
}

.pricing-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: linear-gradient(to left, #f59e0b, #fbbf24);
  color: #0f172a;
  font-weight: 900;
  font-size: 0.625rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 0.25rem 1rem;
  border-bottom-left-radius: 0.75rem;
}

.pricing-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0.25rem;
}

.pricing-subtitle {
  font-size: 0.75rem;
  color: var(--text-dim);
}

.pricing-amount {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  margin-top: 1rem;
}

.pricing-price {
  font-size: 3rem;
  font-weight: 800;
  color: var(--accent-gold);
}

.pricing-currency {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--text-secondary);
}

.pricing-original {
  font-size: 0.75rem;
  color: var(--text-dim);
  text-decoration: line-through;
  margin-left: 0.5rem;
}

.pricing-features {
  list-style: none;
  padding: 1.5rem 0;
  margin: 1.5rem 0;
  border-top: 1px solid var(--border-medium);
  border-bottom: 1px solid var(--border-medium);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.pricing-feature {
  font-size: 0.75rem;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.pricing-feature svg {
  width: 1rem;
  height: 1rem;
  color: var(--accent-gold);
  flex-shrink: 0;
}

.pricing-btn {
  width: 100%;
  padding: 1rem;
  border-radius: 0.75rem;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #0f172a;
  font-weight: 800;
  font-size: 0.875rem;
  border: none;
  cursor: pointer;
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease;
}

.pricing-btn:hover {
  transform: scale(1.02);
}

/* ============================================================================
   PAYMENT METHOD SELECTOR
   ============================================================================ */

.payment-methods-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
}

.payment-method-btn {
  padding: 0.75rem;
  border-radius: 0.75rem;
  font-size: 0.75rem;
  font-weight: 700;
  border: 1px solid var(--border-medium);
  text-align: center;
  transition: all 0.2s ease;
  cursor: pointer;
  background: var(--bg-input);
  color: var(--text-dim);
}

.payment-method-btn:hover {
  border-color: rgba(245, 158, 11, 0.5);
  color: var(--text-main);
}

.payment-method-btn.selected {
  background: rgba(245, 158, 11, 0.15);
  border-color: var(--accent-gold);
  color: var(--accent-gold);
}

.payment-method-btn span {
  display: block;
  font-size: 1.125rem;
  margin-bottom: 0.25rem;
}

/* ============================================================================
   CHECKOUT FORM
   ============================================================================ */

.checkout-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.checkout-field label {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 0.25rem;
}

.checkout-input {
  width: 100%;
  padding: 0.625rem 1rem;
  border-radius: 0.75rem;
  background: var(--bg-input);
  border: 1px solid var(--border-medium);
  color: var(--text-main);
  font-size: 0.75rem;
  outline: none;
  transition: border-color 0.15s ease;
}

.checkout-input:focus {
  border-color: var(--accent-gold);
}

.checkout-input.error {
  border-color: #ef4444;
}

.checkout-error {
  font-size: 0.75rem;
  color: #ef4444;
  margin-top: 0.25rem;
}

.checkout-payment-info {
  padding: 1rem;
  border-radius: 0.75rem;
  background: rgba(245, 158, 11, 0.05);
  border: 1px solid rgba(245, 158, 11, 0.2);
  font-size: 0.75rem;
}

.checkout-payment-info .label {
  font-weight: 700;
  color: var(--accent-gold);
}

.checkout-payment-info .account {
  font-family: var(--font-mono);
  font-weight: 700;
}

.checkout-upload-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  border-radius: 0.75rem;
  border: 2px dashed var(--border-medium);
  cursor: pointer;
  transition: border-color 0.2s ease;
}

.checkout-upload-label:hover {
  border-color: rgba(245, 158, 11, 0.5);
}

.checkout-upload-label svg {
  width: 1.5rem;
  height: 1.5rem;
  color: var(--text-dim);
  margin-bottom: 0.5rem;
}

.checkout-upload-text {
  font-size: 0.75rem;
  color: var(--text-dim);
}

.checkout-upload-hint {
  font-size: 0.625rem;
  color: var(--text-dim);
  margin-top: 0.25rem;
}

.checkout-upload-preview {
  position: relative;
  border-radius: 0.75rem;
  overflow: hidden;
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.checkout-upload-preview img {
  width: 100%;
  height: 10rem;
  object-fit: cover;
}

.checkout-upload-remove {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  padding: 0.375rem;
  border-radius: 0.5rem;
  background: rgba(239, 68, 68, 0.8);
  color: #ffffff;
  border: none;
  cursor: pointer;
}

.checkout-total {
  padding: 1rem;
  border-radius: 0.75rem;
  background: var(--bg-input);
  border: 1px solid var(--border-medium);
  font-size: 0.75rem;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.checkout-total-amount {
  font-weight: 800;
  color: var(--accent-gold);
  font-size: 0.875rem;
}

.checkout-submit-btn {
  width: 100%;
  padding: 0.875rem;
  border-radius: 0.75rem;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #0f172a;
  font-weight: 800;
  font-size: 0.75rem;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease;
}

.checkout-submit-btn:hover {
  transform: scale(1.02);
}

.checkout-submit-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ============================================================================
   PAYMENT STATUS
   ============================================================================ */

.payment-status {
  border-radius: 1rem;
  padding: 2rem;
  text-align: center;
}

.payment-status.pending {
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.3);
}

.payment-status.approved {
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.payment-status.rejected {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
}

.payment-status-icon {
  width: 4rem;
  height: 4rem;
  border-radius: 1rem;
  background: var(--bg-card);
  border: 1px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 1rem;
}

.payment-status-title {
  font-size: 1.25rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
}

.payment-status-desc {
  font-size: 0.875rem;
  color: var(--text-muted);
  max-width: 24rem;
  margin: 0 auto;
}

/* ============================================================================
   AUTH FORMS
   ============================================================================ */

.auth-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1.5rem;
  padding: 2rem;
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
}

.auth-icon {
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 1rem;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-gold);
  margin: 0 auto 1rem;
}

.auth-icon svg {
  width: 1.75rem;
  height: 1.75rem;
}

.auth-title {
  font-size: 1.5rem;
  font-weight: 800;
  text-align: center;
  margin-bottom: 0.25rem;
}

.auth-subtitle {
  font-size: 0.875rem;
  color: var(--text-dim);
  text-align: center;
  margin-bottom: 2rem;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.auth-field label {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 0.375rem;
}

.auth-input {
  width: 100%;
  padding: 0.625rem 1rem;
  border-radius: 0.75rem;
  background: var(--bg-input);
  border: 1px solid var(--border-medium);
  color: var(--text-main);
  font-size: 0.75rem;
  outline: none;
  transition: border-color 0.15s ease;
}

.auth-input:focus {
  border-color: var(--accent-gold);
}

.auth-input.error {
  border-color: #ef4444;
}

.auth-input-wrapper {
  position: relative;
}

.auth-input-wrapper .auth-input {
  padding-right: 2.5rem;
}

.auth-toggle-password {
  position: absolute;
  right: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--text-dim);
  cursor: pointer;
}

.auth-toggle-password svg {
  width: 1rem;
  height: 1rem;
}

.auth-error {
  font-size: 0.75rem;
  color: #ef4444;
  margin-top: 0.25rem;
}

.auth-submit-btn {
  width: 100%;
  padding: 0.875rem;
  border-radius: 0.75rem;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #0f172a;
  font-weight: 800;
  font-size: 0.875rem;
  border: none;
  cursor: pointer;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  transition: transform 0.2s ease;
  margin-top: 0.5rem;
}

.auth-submit-btn:hover {
  transform: scale(1.02);
}

.auth-submit-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.auth-link {
  text-align: center;
  font-size: 0.75rem;
  color: var(--text-dim);
  margin-top: 1.5rem;
}

.auth-link a {
  color: var(--accent-gold);
  font-weight: 700;
  text-decoration: none;
}

.auth-link a:hover {
  color: #fbbf24;
}

.auth-back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--text-dim);
  font-size: 0.875rem;
  font-weight: 500;
  margin-bottom: 2rem;
  text-decoration: none;
  transition: color 0.2s ease;
}

.auth-back-link:hover {
  color: var(--accent-gold);
}

.auth-back-link svg {
  width: 1rem;
  height: 1rem;
}

/* ============================================================================
   ADMIN PANEL
   ============================================================================ */

.admin-layout {
  min-height: 100vh;
  background: var(--bg-main);
  display: flex;
}

.admin-sidebar {
  width: 16rem;
  min-height: 100vh;
  background: var(--bg-card);
  border-right: 1px solid var(--border-medium);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0;
  top: 0;
  z-index: 30;
}

.admin-sidebar-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 2.5rem;
  text-decoration: none;
}

.admin-sidebar-logo {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 0.75rem;
  background: linear-gradient(135deg, #fbbf24, #f59e0b, #d97706);
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-sidebar-logo svg {
  width: 1.5rem;
  height: 1.5rem;
  color: #0f172a;
}

.admin-sidebar-name {
  font-size: 1.125rem;
  font-weight: 800;
}

.admin-sidebar-suffix {
  font-size: 0.563rem;
  letter-spacing: 0.1em;
  color: var(--text-dim);
  font-weight: 500;
  text-transform: uppercase;
  display: block;
}

.admin-nav {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.admin-nav-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  border-radius: 0.75rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-dim);
  text-decoration: none;
  transition: all 0.2s ease;
}

.admin-nav-link:hover {
  color: var(--text-secondary);
  background: var(--bg-pill);
}

.admin-nav-link.active {
  background: rgba(245, 158, 11, 0.15);
  color: var(--accent-gold);
  border: 1px solid rgba(245, 158, 11, 0.3);
  font-weight: 700;
}

.admin-nav-link svg {
  width: 1.25rem;
  height: 1.25rem;
}

.admin-nav-bottom {
  padding-top: 1rem;
  border-top: 1px solid var(--border-medium);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.admin-nav-logout {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  border-radius: 0.75rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: #ef4444;
  background: none;
  border: none;
  cursor: pointer;
  width: 100%;
}

.admin-nav-logout:hover {
  background: rgba(239, 68, 68, 0.1);
}

.admin-nav-logout svg {
  width: 1.25rem;
  height: 1.25rem;
}

.admin-main {
  flex: 1;
  margin-left: 16rem;
}

.admin-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border-medium);
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-header-title {
  font-size: 1.25rem;
  font-weight: 800;
}

.admin-header-subtitle {
  font-size: 0.75rem;
  color: var(--text-dim);
  margin-top: 0.125rem;
}

.admin-content {
  padding: 1.5rem;
}

/* ============================================================================
   ADMIN STATS CARDS
   ============================================================================ */

.admin-stats-grid {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: 1.5rem;
}

@media (min-width: 640px) {
  .admin-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .admin-stats-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.admin-stat-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  padding: 1.5rem;
}

.admin-stat-icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
}

.admin-stat-label {
  font-size: 0.75rem;
  color: var(--text-dim);
  font-weight: 500;
}

.admin-stat-value {
  font-size: 1.5rem;
  font-weight: 800;
  margin-top: 0.25rem;
}

/* ============================================================================
   ADMIN PAYMENTS TABLE
   ============================================================================ */

.admin-table-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  padding: 1rem;
}

.admin-table-row {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1rem;
  border-radius: 0.75rem;
  background: var(--glass-bg);
  border: 1px solid var(--border-medium);
  margin-bottom: 0.75rem;
}

@media (min-width: 640px) {
  .admin-table-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.admin-table-info {
  flex: 1;
}

.admin-table-name {
  font-weight: 700;
  font-size: 0.875rem;
  margin-bottom: 0.25rem;
}

.admin-table-meta {
  font-size: 0.75rem;
  color: var(--text-dim);
}

.admin-table-amount {
  font-size: 1.125rem;
  font-weight: 800;
  color: var(--accent-gold);
}

.admin-table-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.admin-action-btn {
  padding: 0.5rem;
  border-radius: 0.5rem;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease;
}

.admin-action-btn svg {
  width: 1rem;
  height: 1rem;
}

.admin-action-btn.approve {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
}

.admin-action-btn.approve:hover {
  background: rgba(16, 185, 129, 0.2);
}

.admin-action-btn.reject {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.admin-action-btn.reject:hover {
  background: rgba(239, 68, 68, 0.2);
}

.admin-action-btn.view {
  background: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}

.admin-action-btn.view:hover {
  background: rgba(59, 130, 246, 0.2);
}

/* ============================================================================
   ADMIN SEARCH
   ============================================================================ */

.admin-search {
  position: relative;
  margin-bottom: 1.5rem;
}

.admin-search svg {
  position: absolute;
  left: 0.75rem;
  top: 50%;
  transform: translateY(-50%);
  width: 1rem;
  height: 1rem;
  color: var(--text-dim);
}

.admin-search input {
  width: 100%;
  padding: 0.625rem 1rem 0.625rem 2.5rem;
  border-radius: 0.75rem;
  background: var(--bg-input);
  border: 1px solid var(--border-medium);
  color: var(--text-main);
  font-size: 0.75rem;
  outline: none;
}

.admin-search input:focus {
  border-color: var(--accent-gold);
}

/* ============================================================================
   STATUS BADGE
   ============================================================================ */

.status-badge {
  display: inline-block;
  padding: 0.25rem 0.5rem;
  border-radius: 9999px;
  font-size: 0.625rem;
  font-weight: 700;
  border: 1px solid;
  margin-left: 0.75rem;
}

.status-badge.pending {
  background: rgba(245, 158, 11, 0.1);
  color: var(--accent-gold);
  border-color: rgba(245, 158, 11, 0.3);
}

.status-badge.approved {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
  border-color: rgba(16, 185, 129, 0.3);
}

.status-badge.rejected {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  border-color: rgba(239, 68, 68, 0.3);
}

/* ============================================================================
   EMPTY STATE
   ============================================================================ */

.empty-state {
  text-align: center;
  padding: 3rem 1rem;
}

.empty-state svg {
  width: 3rem;
  height: 3rem;
  color: var(--text-dim);
  margin: 0 auto 1rem;
}

.empty-state-title {
  font-size: 1.125rem;
  font-weight: 800;
  margin-bottom: 0.5rem;
}

.empty-state-desc {
  font-size: 0.875rem;
  color: var(--text-dim);
}

/* ============================================================================
   SPINNER
   ============================================================================ */

.spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 3rem;
}

.spinner-circle {
  width: 2rem;
  height: 2rem;
  border: 2px solid var(--bg-pill);
  border-top-color: var(--accent-gold);
  border-radius: 9999px;
  animation: spin 1s linear infinite;
}

.spinner-lg .spinner-circle {
  width: 3rem;
  height: 3rem;
}

.spinner-sm .spinner-circle {
  width: 1rem;
  height: 1rem;
}

/* ============================================================================
   FOOTER
   ============================================================================ */

.site-footer {
  border-top: 1px solid var(--border-medium);
  padding: 2rem 1rem;
  text-align: center;
  font-size: 0.75rem;
  color: var(--text-dim);
  z-index: 10;
  position: relative;
}

.site-footer-inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

@media (min-width: 640px) {
  .site-footer-inner {
    flex-direction: row;
    justify-content: space-between;
  }
}

.site-footer-info {
  display: flex;
  align-items: center;
  gap: 1rem;
}


/* ============================================================================
   REDESIGNED PORTAL LAYOUT
   ============================================================================ */

.portal-page-redesigned {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.portal-header-redesigned {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  gap: 2rem;
  flex-wrap: wrap;
}

.portal-grid-redesigned {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 2rem;
}

@media (max-width: 1024px) {
  .portal-grid-redesigned {
    grid-template-columns: 1fr;
  }
}

/* ============================================================================
   PORTAL NAVIGATION SIDEBAR
   ============================================================================ */

.portal-navigation-sidebar {
  position: sticky;
  top: 100px;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  padding: 1.25rem;
  height: fit-content;
  max-height: calc(100vh - 140px);
  overflow-y: auto;
}

.sidebar-title {
  font-weight: 800;
  font-size: 0.875rem;
  color: var(--text-secondary);
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-medium);
  margin-bottom: 0.75rem;
}

.sidebar-phases {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.sidebar-phase {
  border-radius: 0.5rem;
  overflow: hidden;
}

.sidebar-phase-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.625rem 0.75rem;
  background: transparent;
  border: none;
  color: var(--text-main);
  font-weight: 600;
  font-size: 0.75rem;
  cursor: pointer;
  border-radius: 0.5rem;
  transition: background 0.2s ease;
}

.sidebar-phase-header:hover {
  background: rgba(245, 158, 11, 0.08);
}

.sidebar-phase-header-left {
  display: flex;
  align-items: center;
  gap: 0.375rem;
}

.sidebar-phase-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-phase-duration {
  font-size: 0.625rem;
  color: var(--text-dim);
  flex-shrink: 0;
}

.sidebar-phase-weeks {
  padding-left: 0.5rem;
}

.sidebar-week-group {
  margin-bottom: 0.125rem;
}

.sidebar-week-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.5rem 0.625rem;
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 0.688rem;
  cursor: pointer;
  border-radius: 0.375rem;
  transition: all 0.2s ease;
}

.sidebar-week-item:hover {
  background: var(--bg-pill);
  color: var(--text-main);
}

.sidebar-week-item.selected {
  background: rgba(245, 158, 11, 0.12);
  color: var(--accent-gold);
  font-weight: 600;
}

.sidebar-week-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.125rem;
  overflow: hidden;
}

.sidebar-week-number {
  font-weight: 700;
  color: var(--accent-gold);
  font-size: 0.625rem;
}

.sidebar-week-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-week-progress {
  flex-shrink: 0;
}

.week-progress-text {
  font-size: 0.625rem;
  font-weight: 700;
  color: var(--accent-gold);
}

.sidebar-week-lessons {
  padding-left: 1rem;
  margin-top: 0.125rem;
}

.sidebar-lesson-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.375rem 0.5rem;
  background: transparent;
  border: none;
  color: var(--text-dim);
  font-size: 0.625rem;
  cursor: pointer;
  border-radius: 0.25rem;
  transition: all 0.15s ease;
}

.sidebar-lesson-item:hover {
  background: var(--bg-skeleton);
  color: var(--text-muted);
}

.sidebar-lesson-item.active {
  background: rgba(245, 158, 11, 0.15);
  color: var(--accent-gold);
  font-weight: 600;
}

.sidebar-lesson-left {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  overflow: hidden;
}

.sidebar-lesson-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-lesson-duration {
  font-size: 0.563rem;
  color: var(--text-dim);
  flex-shrink: 0;
}

.sidebar-empty {
  font-size: 0.75rem;
  color: var(--text-dim);
  text-align: center;
  padding: 2rem 0;
}

/* ============================================================================
   WEEK ACCORDION
   ============================================================================ */

.week-accordion {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  overflow: hidden;
  margin-bottom: 0.75rem;
}

.week-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.875rem 1.25rem;
  background: linear-gradient(90deg, rgba(245, 158, 11, 0.3), rgba(245, 158, 11, 0.1));
  border: none;
  color: var(--text-main);
  font-weight: 700;
  font-size: 0.875rem;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.week-header:hover {
  opacity: 0.9;
}

.week-header-left {
  display: flex;
  align-items: center;
  gap: 0.625rem;
}

.week-title-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-header-right {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--accent-gold);
}

.week-progress-badge {
  font-size: 0.75rem;
  font-weight: 700;
  background: rgba(245, 158, 11, 0.2);
  padding: 0.125rem 0.5rem;
  border-radius: 0.375rem;
}

.week-content {
  padding: 1rem;
}

/* ============================================================================
   CLASS CARD
   ============================================================================ */

.class-card {
  border: 1px solid var(--border-medium);
  border-radius: 0.75rem;
  margin-bottom: 0.75rem;
  overflow: hidden;
  transition: border-color 0.2s ease;
}

.class-card:last-child {
  margin-bottom: 0;
}

.class-card.active {
  border-color: rgba(245, 158, 11, 0.5);
}

.class-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.75rem 1rem;
  background: var(--surface-secondary);
  border: none;
  color: var(--text-main);
  cursor: pointer;
  transition: background 0.2s ease;
}

.class-header:hover {
  background: var(--bg-pill);
}

.class-header-left {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  overflow: hidden;
}

.class-status {
  flex-shrink: 0;
  color: var(--accent-gold);
}

.class-status.completed {
  color: #10b981;
}

.class-status.locked {
  color: var(--text-dim);
}

.class-title {
  font-weight: 600;
  font-size: 0.813rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-header-right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.class-duration {
  font-size: 0.688rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
}

.class-content {
  padding: 0.75rem 1rem;
}

/* ============================================================================
   CLASS SECTIONS
   ============================================================================ */

.class-section {
  border: 1px solid var(--border-medium);
  border-radius: 0.5rem;
  overflow: hidden;
  margin-bottom: 0.5rem;
}

.class-section:last-child {
  margin-bottom: 0;
}

.class-section-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.625rem 0.875rem;
  background: var(--surface-secondary);
  border: none;
  color: var(--text-secondary);
  font-weight: 500;
  font-size: 0.75rem;
  cursor: pointer;
  transition: background 0.2s ease;
}

.class-section-header:hover {
  background: var(--bg-skeleton);
}

.section-content {
  padding: 0.75rem;
}

.main-video-info {
  padding: 0.625rem 0.875rem;
  background: rgba(245, 158, 11, 0.08);
  border-left: 3px solid var(--accent-gold);
  border-radius: 0 0.375rem 0.375rem 0;
  margin-bottom: 0.5rem;
}

.video-label {
  display: block;
  font-size: 0.625rem;
  color: var(--text-dim);
  margin-bottom: 0.125rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.video-title {
  font-weight: 600;
  font-size: 0.813rem;
  color: var(--text-main);
}

.notes-text {
  line-height: 1.6;
  color: var(--text-muted);
  white-space: pre-wrap;
  font-size: 0.75rem;
}

.questions-placeholder {
  color: var(--text-dim);
  font-size: 0.75rem;
  font-style: italic;
  text-align: center;
  padding: 0.5rem;
}

.checklist-items {
  list-style: none;
  padding: 0;
  margin: 0;
}

.checklist-item {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  padding: 0.375rem 0;
}

.checklist-item input[type="checkbox"] {
  width: 15px;
  height: 15px;
  cursor: pointer;
  accent-color: var(--accent-gold);
}

.checklist-item label {
  cursor: pointer;
  color: var(--text-secondary);
  font-size: 0.75rem;
}

.class-locked-message {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem;
  background: var(--surface-secondary);
  color: var(--text-dim);
  text-align: center;
  font-size: 0.75rem;
  border-radius: 0.375rem;
}

/* ============================================================================
   RESPONSIVE
   ============================================================================ */

@media (max-width: 1024px) {
  .portal-navigation-sidebar {
    position: static;
    max-height: none;
    margin-bottom: 1.5rem;
  }
}

@media (max-width: 768px) {
  .portal-header-redesigned {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* ============================================================================
   VIDEO PLAYER OVERLAY
   ============================================================================ */

.video-player-overlay {
  margin-bottom: 1.5rem;
}

.video-player-container {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: 1rem;
  overflow: hidden;
  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
}

.video-player-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 1.25rem;
  background: var(--bg-input);
  border-bottom: 1px solid var(--border-medium);
  gap: 1rem;
  flex-wrap: wrap;
}

.video-player-lesson-info {
  flex: 1;
  min-width: 0;
}

.video-player-lesson-label {
  display: block;
  font-size: 0.625rem;
  font-weight: 700;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.125rem;
}

.video-player-lesson-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-player-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.video-player-close-btn {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.5rem 0.875rem;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  border-radius: 0.5rem;
  color: #ef4444;
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.video-player-close-btn:hover {
  background: rgba(239, 68, 68, 0.2);
}

/* ============================================================================
   CLASS DETAILS (Below header, always visible sections)
   ============================================================================ */

.class-details {
  padding: 0.5rem 0.75rem 0.75rem;
}



/* ============================================================================
   STICKY VIDEO WRAPPER
   ============================================================================ */

.sticky-video-wrapper {
  position: sticky;
  top: 100px;
  z-index: 20;
  margin-bottom: 1.5rem;
}

/* ============================================================================
   UP NEXT CARD
   ============================================================================ */

.up-next-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 1.25rem;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 0.75rem;
  margin-top: 0.75rem;
  cursor: pointer;
  transition: all 0.3s ease;
}

.up-next-card:hover {
  border-color: rgba(245, 158, 11, 0.5);
  transform: translateY(-2px);
  box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.15);
}

.up-next-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.up-next-label {
  font-size: 0.625rem;
  font-weight: 700;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.up-next-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-main);
}

.up-next-duration {
  font-size: 0.688rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
}

.up-next-play-btn {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.5rem 1rem;
  background: var(--accent-gold);
  color: #0f172a;
  font-weight: 700;
  font-size: 0.75rem;
  border: none;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: background 0.2s ease;
  flex-shrink: 0;
}

.up-next-play-btn:hover {
  background: #fbbf24;
}

.up-next-completed {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.875rem 1.25rem;
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.3);
  border-radius: 0.75rem;
  margin-top: 0.75rem;
  color: #10b981;
  font-weight: 600;
  font-size: 0.875rem;
}

/* ============================================================================
   PROGRESS RING
   ============================================================================ */

.progress-ring {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.progress-ring-circle {
  transition: stroke-dashoffset 0.5s ease;
}

/* ============================================================================
   SESSION CHAPTERS (YouTube Style)
   ============================================================================ */

.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.chapter-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.625rem 0.75rem;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
}

.chapter-item:hover {
  background: rgba(245, 158, 11, 0.08);
}

.chapter-item.active {
  background: rgba(245, 158, 11, 0.12);
  border-color: rgba(245, 158, 11, 0.3);
}

.chapter-indicator {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 9999px;
  background: var(--accent-gold);
  flex-shrink: 0;
}

.chapter-item.active .chapter-indicator {
  background: #10b981;
  box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
}

.chapter-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.chapter-title {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--text-secondary);
}

.chapter-item.active .chapter-title {
  color: var(--text-main);
  font-weight: 600;
}

.chapter-time {
  font-size: 0.625rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
}

/* ============================================================================
   PORTAL V2 - PROFESSIONAL LMS LAYOUT
   ============================================================================ */

.portal-v2 {
  max-width: 1400px;
  margin: 0 auto;
  padding: 1.5rem 1rem;
}

.portal-v2-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: 1.5rem;
  align-items: start;
}

@media (max-width: 1024px) {
  .portal-v2-grid {
    grid-template-columns: 1fr;
  }
}

/* ============================================================================
   VIDEO OVERLAY V2
   ============================================================================ */

.video-overlay-wrapper {
  margin-bottom: 1.5rem;
}

.video-overlay-container {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245,158,11,0.25);
  border-radius: 1rem;
  overflow: hidden;
  box-shadow: 0 20px 40px -15px rgba(0,0,0,0.5);
}

.video-overlay-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.25rem;
  background: var(--bg-input);
  border-bottom: 1px solid var(--border-medium);
  gap: 1rem;
  flex-wrap: wrap;
}

.video-overlay-info { flex: 1; min-width: 0; }

.video-overlay-label {
  font-size: 0.625rem; font-weight: 700; color: var(--accent-gold);
  text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 0.125rem;
}

.video-overlay-title {
  font-size: 1rem; font-weight: 700; color: var(--text-main);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.video-overlay-actions {
  display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0;
}

.video-close-btn {
  display: flex; align-items: center; gap: 0.375rem;
  padding: 0.5rem 0.875rem; border-radius: 0.5rem;
  background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3);
  color: #ef4444; font-size: 0.75rem; font-weight: 600; cursor: pointer;
  transition: all 0.2s;
}
.video-close-btn:hover { background: rgba(239,68,68,0.2); }

/* ============================================================================
   SIDEBAR V2
   ============================================================================ */

.portal-v2-sidebar {
  position: sticky; top: 100px;
  display: flex; flex-direction: column; gap: 1rem;
}

.sidebar-quick-nav {
  display: flex; flex-direction: column; gap: 0.25rem;
  background: var(--glass-bg); backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(245,158,11,0.2);
  border-radius: 0.75rem; padding: 0.5rem;
}

.sidebar-nav-item {
  display: flex; align-items: center; gap: 0.625rem;
  padding: 0.625rem 0.75rem; border-radius: 0.5rem;
  font-size: 0.813rem; font-weight: 500; color: var(--text-muted);
  text-decoration: none; transition: all 0.2s;
}
.sidebar-nav-item:hover { background: rgba(245,158,11,0.08); color: var(--text-main); }
.sidebar-nav-item.active { background: rgba(245,158,11,0.12); color: var(--accent-gold); font-weight: 600; }

.sidebar-progress-widget {
  background: var(--glass-bg); backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(245,158,11,0.2);
  border-radius: 0.75rem; padding: 1rem; text-align: center;
}

.widget-title {
  font-size: 0.75rem; font-weight: 700; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.75rem;
}

.widget-progress-ring { display: flex; justify-content: center; margin-bottom: 0.75rem; }

.widget-stats { display: flex; justify-content: center; gap: 1.5rem; }

.widget-stat { text-align: center; }

.widget-stat-value {
  display: flex; align-items: center; justify-content: center; gap: 0.25rem;
  font-size: 1rem; font-weight: 700; color: var(--text-main);
}

.widget-stat-label { font-size: 0.625rem; color: var(--text-dim); }

.sidebar-phase-nav {
  background: var(--glass-bg); backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(245,158,11,0.2);
  border-radius: 0.75rem; padding: 0.75rem;
}

.sidebar-phase-group { margin-bottom: 0.25rem; }

.sidebar-phase-toggle {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding: 0.5rem 0.625rem; border: none; background: none;
  color: var(--text-main); font-size: 0.75rem; font-weight: 600;
  border-radius: 0.375rem; cursor: pointer; transition: background 0.2s;
}
.sidebar-phase-toggle:hover { background: rgba(245,158,11,0.06); }
.sidebar-phase-toggle.open { color: var(--accent-gold); }

.sidebar-phase-toggle-left { display: flex; align-items: center; gap: 0.375rem; }

.sidebar-week-item {
  display: flex; align-items: center; gap: 0.5rem;
  width: 100%; padding: 0.375rem 0.5rem 0.375rem 1.5rem;
  border: none; background: none; color: var(--text-muted);
  font-size: 0.688rem; cursor: pointer; border-radius: 0.25rem; transition: all 0.15s;
}
.sidebar-week-item:hover { background: var(--bg-skeleton); color: var(--text-main); }
.sidebar-week-item.active { background: rgba(245,158,11,0.1); color: var(--accent-gold); font-weight: 600; }

.sidebar-week-num { font-weight: 700; color: var(--accent-gold); font-size: 0.625rem; }
.sidebar-week-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sidebar-week-pct { font-size: 0.625rem; font-weight: 700; color: var(--accent-gold); }

.sidebar-live-widget {
  background: var(--glass-bg); backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(245,158,11,0.2);
  border-radius: 0.75rem; padding: 0.75rem;
}

.live-session-info { padding: 0.5rem; }

.live-session-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; }

.live-dot {
  width: 8px; height: 8px; border-radius: 9999px;
  background: #ef4444; animation: pulse 2s infinite;
}

.live-label { font-size: 0.75rem; font-weight: 600; color: var(--text-main); }

.live-session-title { font-size: 0.688rem; color: var(--text-muted); margin-bottom: 0.375rem; }

.live-session-meta {
  display: flex; align-items: center; gap: 0.375rem;
  font-size: 0.625rem; color: var(--text-dim);
}

/* ============================================================================
   MAIN CONTENT V2
   ============================================================================ */

.portal-v2-main { display: flex; flex-direction: column; gap: 1.5rem; }

.breadcrumb-nav {
  display: flex; align-items: center; gap: 0.375rem;
  font-size: 0.75rem; color: var(--text-dim); flex-wrap: wrap;
}

.breadcrumb-item {
  color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 0.25rem;
}
.breadcrumb-item:hover { color: var(--accent-gold); }
.breadcrumb-item.active { color: var(--text-main); font-weight: 600; }

.breadcrumb-sep { color: var(--text-dim); flex-shrink: 0; }

/* ============================================================================
   PHASE CARD V2
   ============================================================================ */

.phase-card-v2 {
  background: var(--glass-bg); backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(245,158,11,0.2);
  border-radius: 1rem; padding: 1.25rem;
}

.phase-card-header {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 1rem; margin-bottom: 0.75rem;
}

.phase-badge {
  display: inline-block; padding: 0.25rem 0.625rem;
  background: rgba(245,158,11,0.12); color: var(--accent-gold);
  font-size: 0.625rem; font-weight: 700; border-radius: 0.375rem;
  margin-bottom: 0.375rem;
}

.phase-card-title { font-size: 1.125rem; font-weight: 700; color: var(--text-main); }

.phase-card-desc { font-size: 0.75rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 0.75rem; }

.phase-card-outcomes {
  padding: 0.75rem; border-radius: 0.5rem;
  background: var(--surface-secondary); border: 1px solid var(--border-medium);
}

.phase-card-outcomes-label {
  font-size: 0.625rem; font-weight: 700; color: var(--accent-gold);
  text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.5rem;
}

.phase-card-outcomes-list { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }
.phase-card-outcomes-list li { font-size: 0.688rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.375rem; }

.phase-weeks { margin-top: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }

/* ============================================================================
   WEEK ACCORDION V2
   ============================================================================ */

.week-accordion-v2 {
  background: var(--bg-card); border: 1px solid var(--border-medium);
  border-radius: 0.75rem; overflow: hidden;
}

.week-accordion-header {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding: 0.75rem 1rem; border: none;
  background: linear-gradient(90deg, rgba(245,158,11,0.2), rgba(245,158,11,0.05));
  color: var(--text-main); font-weight: 600; font-size: 0.813rem; cursor: pointer;
  transition: opacity 0.2s; gap: 0.75rem;
}
.week-accordion-header:hover { opacity: 0.85; }

.week-header-left { display: flex; align-items: center; gap: 0.5rem; }

.week-number-badge {
  font-weight: 700; color: var(--accent-gold); font-size: 0.75rem;
}

.week-title-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.week-header-right { display: flex; align-items: center; gap: 0.5rem; font-size: 0.688rem; color: var(--text-dim); flex-shrink: 0; }

.week-duration-text { color: var(--text-dim); }

.week-progress-text { font-weight: 600; color: var(--text-muted); }

.week-progress-badge {
  padding: 0.125rem 0.5rem; border-radius: 0.375rem;
  background: rgba(245,158,11,0.15); color: var(--accent-gold);
  font-size: 0.688rem; font-weight: 700;
}

.week-accordion-body { padding: 0.75rem; }

/* ============================================================================
   TODO LIST
   ============================================================================ */

.week-todo-section {
  margin-bottom: 0.75rem; border: 1px solid var(--border-light);
  border-radius: 0.5rem; overflow: hidden;
}

.todo-toggle {
  display: flex; align-items: center; gap: 0.5rem;
  width: 100%; padding: 0.5rem 0.75rem; border: none;
  background: var(--surface-secondary); color: var(--text-muted);
  font-size: 0.75rem; font-weight: 500; cursor: pointer;
}

.todo-items { list-style: none; padding: 0.5rem 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; }

.todo-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.688rem; color: var(--text-muted); }
.todo-item input[type="checkbox"] { accent-color: var(--accent-gold); width: 14px; height: 14px; cursor: pointer; }
.todo-item label { cursor: pointer; }

/* ============================================================================
   CLASS CARD V2
   ============================================================================ */

.class-card-v2 {
  border: 1px solid var(--border-medium); border-radius: 0.625rem;
  overflow: hidden; margin-bottom: 0.5rem; transition: border-color 0.2s;
}
.class-card-v2.active { border-color: rgba(245,158,11,0.4); }

.class-card-header {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding: 0.625rem 0.875rem; border: none;
  background: var(--surface-secondary); color: var(--text-main);
  cursor: pointer; transition: background 0.2s;
}
.class-card-header:hover { background: var(--bg-skeleton); }

.class-header-left { display: flex; align-items: center; gap: 0.5rem; overflow: hidden; }

.class-number { font-weight: 700; color: var(--accent-gold); font-size: 0.688rem; }

.class-title-text { font-size: 0.75rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.class-duration-text { font-size: 0.625rem; color: var(--text-dim); font-family: var(--font-mono); flex-shrink: 0; }

.class-card-body { padding: 0.5rem 0.75rem 0.75rem; }

.class-section-v2 {
  border: 1px solid rgba(51,65,85,0.12); border-radius: 0.375rem;
  overflow: hidden; margin-bottom: 0.375rem;
}
.class-section-v2:last-child { margin-bottom: 0; }

.class-section-toggle {
  display: flex; align-items: center; gap: 0.375rem;
  width: 100%; padding: 0.5rem 0.625rem; border: none;
  background: rgba(15,23,42,0.2); color: var(--text-muted);
  font-size: 0.688rem; font-weight: 500; cursor: pointer;
  transition: background 0.2s;
}
.class-section-toggle:hover { background: rgba(30,41,59,0.25); }

.class-section-body { padding: 0.5rem 0.625rem; }

.main-video-card {
  display: flex; align-items: center; gap: 0.625rem;
  padding: 0.5rem; border-radius: 0.375rem;
  background: rgba(245,158,11,0.06); transition: background 0.2s;
}
.main-video-card:hover { background: rgba(245,158,11,0.12); }

.main-video-thumb {
  width: 36px; height: 36px; border-radius: 0.25rem;
  background: var(--bg-input); display: flex; align-items: center;
  justify-content: center; flex-shrink: 0;
}

.main-video-info { display: flex; flex-direction: column; gap: 0.125rem; }

.video-card-label { font-size: 0.563rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; }

.video-card-title { font-size: 0.75rem; font-weight: 600; color: var(--text-main); }

.video-card-duration { font-size: 0.625rem; color: var(--accent-gold); font-family: var(--font-mono); }

.session-chapters-wrapper { margin-top: 0.5rem; }

.section-sub-label {
  font-size: 0.563rem; font-weight: 700; color: var(--text-dim);
  text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.375rem;
}

.notes-content {
  font-size: 0.688rem; color: var(--text-muted); line-height: 1.6; white-space: pre-wrap;
}

.notes-empty {
  font-size: 0.688rem; color: var(--text-dim); font-style: italic; text-align: center; padding: 0.5rem;
}

.resource-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.375rem 0; font-size: 0.688rem; color: var(--text-muted);
  border-bottom: 1px solid var(--border-light);
}
.resource-row:last-child { border-bottom: none; }

.resource-type {
  font-size: 0.563rem; padding: 0.125rem 0.375rem; border-radius: 0.25rem;
  background: rgba(245,158,11,0.1); color: var(--accent-gold);
  font-weight: 600; text-transform: uppercase;
}

.checklist-v2 { list-style: none; display: flex; flex-direction: column; gap: 0.25rem; }
.checklist-v2 li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.688rem; color: var(--text-muted); }
.checklist-v2 input[type="checkbox"] { accent-color: var(--accent-gold); width: 14px; height: 14px; cursor: pointer; }
.checklist-v2 label { cursor: pointer; }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ============================================================================
   SENIOR LMS PORTAL - One phase at a time, video left, weeks right
   ============================================================================ */

.portal-senior {
  max-width: 1400px;
  margin: 0 auto;
  padding: 1.25rem 1rem;
}

/* Top Bar */
.senior-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245,158,11,0.15);
  border-radius: 0.75rem;
  margin-bottom: 1.5rem;
  gap: 1rem;
  flex-wrap: wrap;
}

.senior-breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.75rem;
}

.senior-breadcrumb-link {
  color: var(--text-muted);
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}
.senior-breadcrumb-link:hover { color: var(--accent-gold); }

.senior-breadcrumb-sep { color: var(--text-dim); flex-shrink: 0; }

.senior-breadcrumb-current {
  color: var(--text-main);
  font-weight: 600;
}

.senior-progress {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.senior-progress-text {
  font-size: 0.688rem;
  color: var(--text-dim);
  white-space: nowrap;
}

.senior-progress-track {
  width: 8rem;
  height: 0.5rem;
  border-radius: 9999px;
  background: var(--border-hover);
  overflow: hidden;
}

.senior-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
  border-radius: 9999px;
  transition: width 0.5s ease;
}

/* Phase Selection Grid */
.senior-phase-grid {
  padding: 1rem 0;
}

.senior-section-title {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 1.25rem;
}

.senior-phase-cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1rem;
}

.senior-phase-select-card {
  display: flex;
  flex-direction: column;
  padding: 1.25rem;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245,158,11,0.2);
  border-radius: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  text-align: left;
  color: var(--text-main);
}
.senior-phase-select-card:hover {
  border-color: rgba(245,158,11,0.5);
  transform: translateY(-2px);
  box-shadow: 0 12px 30px -10px rgba(245,158,11,0.15);
}

.senior-phase-select-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.senior-phase-select-number {
  font-size: 0.688rem;
  font-weight: 700;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: rgba(245,158,11,0.1);
  padding: 0.25rem 0.625rem;
  border-radius: 0.375rem;
}

.senior-phase-select-title {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 0.375rem;
}

.senior-phase-select-subtitle {
  font-size: 0.688rem;
  color: var(--text-muted);
  line-height: 1.5;
  flex: 1;
  margin-bottom: 0.75rem;
}

.senior-phase-select-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border-medium);
}

.senior-phase-select-duration {
  font-size: 0.688rem;
  color: var(--text-dim);
}

/* Phase View Layout */
.senior-phase-view {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  /* Constrain the entire phase view height so it doesn't push past viewport */
  max-height: calc(100vh - 140px);
}

.senior-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.5rem 0.75rem;
  background: transparent;
  border: 1px solid rgba(245,158,11,0.2);
  border-radius: 0.5rem;
  color: var(--accent-gold);
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  align-self: flex-start;
  flex-shrink: 0;
}
.senior-back-btn:hover {
  background: rgba(245,158,11,0.1);
}

.senior-phase-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  align-items: start;
  /* Allow the accordion column to scroll independently */
  overflow: hidden;
}

@media (max-width: 1024px) {
  .senior-phase-layout {
    grid-template-columns: 1fr;
    overflow: visible;
  }
}

/* Accordion Column — scrolls independently */
.senior-accordion-column {
  overflow-y: auto;
  max-height: calc(100vh - 200px);
  padding-right: 0.5rem;
  /* Custom scrollbar styling */
  scrollbar-width: thin;
  scrollbar-color: rgba(245,158,11,0.3) transparent;
}

.senior-accordion-column::-webkit-scrollbar {
  width: 5px;
}

.senior-accordion-column::-webkit-scrollbar-track {
  background: transparent;
}

.senior-accordion-column::-webkit-scrollbar-thumb {
  background: rgba(245,158,11,0.3);
  border-radius: 10px;
}

/* Video Column — stays fixed while accordion scrolls */
.senior-video-column {
  position: sticky;
  top: 10px;
  align-self: start;
}

.senior-video-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245,158,11,0.2);
  border-radius: 0.75rem;
  overflow: hidden;
}

.senior-video-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.625rem 1rem;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-medium);
  gap: 0.75rem;
}

.senior-video-label {
  font-size: 0.563rem;
  font-weight: 700;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  display: block;
  margin-bottom: 0.125rem;
}

.senior-video-title {
  font-size: 0.813rem;
  font-weight: 700;
  color: var(--text-main);
}

.senior-video-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 0.375rem;
  background: rgba(239,68,68,0.1);
  border: 1px solid rgba(239,68,68,0.2);
  color: #ef4444;
  cursor: pointer;
  transition: all 0.2s;
}
.senior-video-close:hover { background: rgba(239,68,68,0.2); }

.senior-video-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 3rem 1.5rem;
  background: var(--surface-secondary);
  border: 1px solid var(--border-medium);
  border-radius: 0.75rem;
  min-height: 300px;
}

/* Session List below video */
.senior-sessions-list {
  padding: 0.75rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.senior-sessions-label {
  font-size: 0.625rem;
  font-weight: 700;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.375rem;
}

.senior-session-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.625rem;
  border-radius: 0.375rem;
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-muted);
  font-size: 0.688rem;
  cursor: pointer;
  transition: all 0.2s;
}
.senior-session-item:hover {
  background: rgba(245,158,11,0.06);
}
.senior-session-item.active {
  background: rgba(245,158,11,0.1);
  border-color: rgba(245,158,11,0.3);
  color: var(--text-main);
}

.senior-session-num {
  font-weight: 700;
  color: var(--accent-gold);
  font-size: 0.625rem;
  min-width: 16px;
}

.senior-session-name {
  flex: 1;
  text-align: left;
}

.senior-session-time {
  font-family: var(--font-mono);
  font-size: 0.625rem;
  color: var(--text-dim);
}

/* Weeks Column */
.senior-weeks-column {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.senior-phase-info-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245,158,11,0.2);
  border-radius: 0.75rem;
  padding: 1rem;
}

.senior-phase-info-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
}

.senior-phase-badge {
  display: inline-block;
  padding: 0.2rem 0.5rem;
  background: rgba(245,158,11,0.12);
  color: var(--accent-gold);
  font-size: 0.625rem;
  font-weight: 700;
  border-radius: 0.25rem;
  margin-bottom: 0.25rem;
}

.senior-phase-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-main);
}

.senior-phase-desc {
  font-size: 0.688rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin-bottom: 0.625rem;
}

.senior-phase-outcomes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}

.senior-outcome-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.2rem 0.5rem;
  background: rgba(16,185,129,0.08);
  border: 1px solid rgba(16,185,129,0.2);
  border-radius: 0.25rem;
  font-size: 0.625rem;
  color: #10b981;
}

/* Week Cards */
.senior-weeks-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.senior-week-card {
  background: var(--surface-secondary);
  border: 1px solid var(--border-medium);
  border-radius: 0.625rem;
  overflow: hidden;
}

.senior-week-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.625rem 0.875rem;
  border: none;
  background: linear-gradient(90deg, rgba(245,158,11,0.15), rgba(245,158,11,0.03));
  color: var(--text-main);
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.2s;
  gap: 0.5rem;
}
.senior-week-header:hover { opacity: 0.85; }

.senior-week-header-left {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  overflow: hidden;
}

.senior-week-number {
  font-weight: 700;
  color: var(--accent-gold);
}

.senior-week-title-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.senior-week-header-right {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.625rem;
  color: var(--text-dim);
  flex-shrink: 0;
}

.senior-week-lessons {
  padding: 0.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.senior-lesson-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.5rem 0.625rem;
  border: none;
  border-radius: 0.375rem;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.15s;
  text-align: left;
}
.senior-lesson-item:hover {
  background: var(--bg-skeleton);
  color: var(--text-main);
}
.senior-lesson-item.active {
  background: rgba(245,158,11,0.1);
  border: 1px solid rgba(245,158,11,0.3);
  color: var(--text-main);
}
.senior-lesson-item.done {
  color: #10b981;
}

.senior-lesson-left {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  overflow: hidden;
}

.senior-lesson-title {
  font-size: 0.688rem;
  font-weight: 500;
  display: block;
}

.senior-lesson-video-name {
  font-size: 0.563rem;
  color: var(--text-dim);
  display: block;
}

.senior-lesson-duration {
  font-size: 0.625rem;
  font-family: var(--font-mono);
  color: var(--text-dim);
  flex-shrink: 0;
}

/* ============================================================================
   CLASS VIDEOS - Live Session + Session by Session
   ============================================================================ */

.senior-class-group {
  border: 1px solid transparent;
  border-radius: 0.5rem;
  margin-bottom: 0.25rem;
  transition: border-color 0.2s;
}
.senior-class-group.active {
  border-color: rgba(245,158,11,0.25);
  background: rgba(245,158,11,0.04);
}

.senior-class-videos {
  padding: 0.25rem 0.5rem 0.5rem 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

/* Live Session Video Link */
.senior-video-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.5rem 0.625rem;
  border-radius: 0.375rem;
  background: rgba(239,68,68,0.06);
  border: 1px solid rgba(239,68,68,0.15);
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.2s;
  text-align: left;
}
.senior-video-link:hover {
  background: rgba(239,68,68,0.1);
  border-color: rgba(239,68,68,0.3);
}
.senior-video-link.active {
  background: rgba(239,68,68,0.12);
  border-color: rgba(239,68,68,0.4);
}

.senior-video-link-icon {
  color: #ef4444;
  flex-shrink: 0;
}

.senior-video-link-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
  overflow: hidden;
}

.senior-video-link-label {
  font-size: 0.5rem;
  font-weight: 700;
  color: #ef4444;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.senior-video-link-title {
  font-size: 0.688rem;
  font-weight: 500;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.senior-video-link-badge {
  font-size: 0.5rem;
  font-weight: 700;
  padding: 0.125rem 0.375rem;
  border-radius: 0.25rem;
  background: #ef4444;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  flex-shrink: 0;
}

/* Session by Session */
.senior-session-by-session {
  padding: 0.25rem 0;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.senior-sessions-section-label {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.5rem;
  font-weight: 700;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.25rem 0.375rem;
}

.senior-session-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.375rem 0.5rem;
  border-radius: 0.25rem;
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.15s;
  text-align: left;
  font-size: 0.625rem;
}
.senior-session-link:hover {
  background: rgba(245,158,11,0.06);
  color: var(--text-main);
}
.senior-session-link.active {
  background: rgba(245,158,11,0.1);
  border-color: rgba(245,158,11,0.25);
  color: var(--text-main);
  font-weight: 500;
}

.senior-session-link-num {
  font-weight: 700;
  color: var(--accent-gold);
  font-size: 0.563rem;
  min-width: 14px;
}

.senior-session-link-title {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.senior-session-link-time {
  font-family: var(--font-mono);
  font-size: 0.563rem;
  color: var(--text-dim);
  flex-shrink: 0;
}

/* ============================================================================
   CLASS HEADER ROW - Lesson button + Accordion toggle side by side
   ============================================================================ */

.senior-class-header-row {
  display: flex;
  align-items: stretch;
}

.senior-class-header-row .senior-lesson-item {
  flex: 1;
}

/* Accordion toggle button for class videos */
.senior-class-accordion-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  min-width: 32px;
  border: none;
  background: var(--surface-secondary);
  color: var(--text-dim);
  cursor: pointer;
  transition: all 0.2s ease;
  border-left: 1px solid var(--border-medium);
}

.senior-class-accordion-toggle:hover {
  background: rgba(245, 158, 11, 0.1);
  color: var(--accent-gold);
}

.senior-class-accordion-toggle.open {
  background: rgba(245, 158, 11, 0.08);
  color: var(--accent-gold);
}

/* ============================================================================
   CLASS TITLE BAR - Plain text label, not clickable
   ============================================================================ */

.senior-class-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  padding: 0.5rem 0.625rem;
  background: transparent;
  color: var(--text-muted);
  font-size: 0.75rem;
  gap: 0.5rem;
}

.senior-class-title-bar.done {
  color: #10b981;
}

.senior-class-title-left {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  overflow: hidden;
}

/* ============================================================================
   CLASS TITLE BAR - Full width clickable, controls accordion
   ============================================================================ */

.senior-class-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.5rem 0.75rem;
  background: transparent;
  border: none;
  color: var(--text-muted);
  font-size: 0.75rem;
  cursor: pointer;
  transition: background 0.2s ease;
  gap: 0.5rem;
}
.senior-class-title-bar:hover {
  background: rgba(245, 158, 11, 0.04);
}
.senior-class-title-bar.done {
  color: #10b981;
}

.senior-class-title-left {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  overflow: hidden;
}

.senior-class-title-right {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.senior-class-accordion-arrow {
  display: flex;
  align-items: center;
  color: var(--text-dim);
  transition: color 0.2s;
}
.senior-class-accordion-arrow.open {
  color: var(--accent-gold);
}

/* ============================================================
   CHECKOUT FORM — PAYMENT INFO WITH COPY BUTTON
   ============================================================ */

/* Payment method name heading */
.checkout-payment-method-name {
  margin-bottom: 0.5rem;
}

.checkout-payment-method-name .label {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Account number row — flex container for label + number + copy button */
.checkout-payment-account-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
  padding: 0.625rem 0.75rem;
  background: rgba(245, 158, 11, 0.06);
  border: 1px solid rgba(245, 158, 11, 0.15);
  border-radius: 0.5rem;
  flex-wrap: wrap;
}

.checkout-payment-account-label {
  font-size: 0.75rem;
  color: var(--text-muted);
  white-space: nowrap;
}

.checkout-payment-account-number {
  font-size: 0.9375rem;
  font-weight: 700;
  font-family: 'JetBrains Mono', 'Fira Code', monospace;
  color: var(--text-main);
  letter-spacing: 0.02em;
  user-select: all;
}

/* Copy button — icon-only, minimal footprint */
.copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border: 1px solid var(--border-medium);
  border-radius: 0.375rem;
  background: var(--border-light);
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
  margin-left: auto;
}

.copy-btn:hover {
  background: rgba(245, 158, 11, 0.12);
  border-color: rgba(245, 158, 11, 0.3);
  color: var(--accent-gold);
}

.copy-btn:active {
  transform: scale(0.92);
  transition: transform 0.1s ease;
}

/* Account name — secondary info */
.checkout-payment-account-name {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-bottom: 0.75rem;
}

.checkout-payment-account-name span {
  font-weight: 600;
  color: var(--text-main);
}

/* Payment instructions — helper text */
.checkout-payment-instructions {
  font-size: 0.75rem;
  color: var(--text-dim);
  line-height: 1.6;
  margin-top: 0.25rem;
}

/* Optional field label modifier */
.checkout-field-optional {
  color: var(--text-dim);
  font-weight: 400;
  font-size: 0.75rem;
}

/* ============================================================
   PURCHASE MODE SELECTOR
   ============================================================ */

.purchase-mode-selector {
  margin-bottom: 2rem;
}

.purchase-mode-header {
  text-align: center;
  margin-bottom: 1.5rem;
}

.purchase-mode-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0.5rem;
}

.purchase-mode-subtitle {
  font-size: 0.875rem;
  color: var(--text-muted);
  max-width: 28rem;
  margin: 0 auto;
}

.purchase-mode-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1rem;
  max-width: 40rem;
  margin: 0 auto;
}

.purchase-mode-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 1.5rem;
  background: var(--bg-input);
  border: 2px solid var(--border-medium);
  border-radius: 1rem;
  cursor: pointer;
  transition: all 0.25s ease;
  gap: 0.5rem;
}

.purchase-mode-card:hover {
  border-color: rgba(245, 158, 11, 0.3);
  background: rgba(245, 158, 11, 0.05);
}

.purchase-mode-card.selected {
  border-color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.08);
  box-shadow: 0 0 20px rgba(245, 158, 11, 0.1);
}

.purchase-mode-badge {
  position: absolute;
  top: -0.625rem;
  right: 1rem;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: var(--bg-main);
  font-size: 0.625rem;
  font-weight: 800;
  padding: 0.25rem 0.75rem;
  border-radius: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.purchase-mode-icon {
  color: var(--accent-gold);
}

.purchase-mode-label {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-main);
}

.purchase-mode-desc {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.purchase-mode-price {
  display: flex;
  align-items: baseline;
  gap: 0.375rem;
  margin-top: 0.5rem;
}

.purchase-mode-price-amount {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text-main);
}

.purchase-mode-price-unit {
  font-size: 0.75rem;
  color: var(--text-dim);
}

.purchase-mode-price-original {
  font-size: 0.75rem;
  color: var(--text-dim);
  text-decoration: line-through;
}

.purchase-mode-savings {
  font-size: 0.688rem;
  font-weight: 700;
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
}

.purchase-mode-radio {
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 50%;
  border: 2px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 0.5rem;
}

.purchase-mode-radio.checked {
  border-color: var(--accent-gold);
  background: var(--accent-gold);
}

.purchase-mode-radio-dot {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--bg-main);
}

/* ============================================================
   PHASE SELECTOR
   ============================================================ */

.phase-selector {
  margin-bottom: 1.5rem;
}

.phase-selector-header {
  margin-bottom: 1rem;
}

.phase-selector-header h3 {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0.25rem;
}

.phase-selector-header p {
  font-size: 0.75rem;
  color: var(--text-muted);
}

.phase-selector-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.phase-selector-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  background: var(--surface-secondary);
  border: 1px solid var(--border-light);
  border-radius: 0.75rem;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: left;
  width: 100%;
}

.phase-selector-item:hover:not(.locked) {
  border-color: rgba(245, 158, 11, 0.25);
  background: rgba(245, 158, 11, 0.04);
}

.phase-selector-item.selected {
  border-color: rgba(245, 158, 11, 0.4);
  background: rgba(245, 158, 11, 0.06);
}

.phase-selector-item.locked {
  opacity: 0.5;
  cursor: not-allowed;
}

.phase-selector-checkbox {
  width: 1.375rem;
  height: 1.375rem;
  border-radius: 0.25rem;
  border: 2px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.phase-selector-checkbox.checked {
  background: var(--accent-gold);
  border-color: var(--accent-gold);
  color: var(--bg-main);
}

.phase-selector-info {
  flex: 1;
  min-width: 0;
}

.phase-selector-title-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.phase-selector-number {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--text-main);
}

.phase-selector-prereq-met {
  color: #10b981;
  display: flex;
  align-items: center;
}

.phase-selector-prereq-locked {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.688rem;
  color: var(--text-dim);
}

.phase-selector-no-prereq {
  display: block;
  font-size: 0.688rem;
  color: #10b981;
  margin-top: 0.125rem;
}

.phase-selector-price {
  text-align: right;
  flex-shrink: 0;
}

.phase-selector-price-amount {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--text-main);
}

.phase-selector-arrow {
  color: var(--text-dim);
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.phase-selector-arrow.rotated {
  transform: rotate(90deg);
}

.phase-selector-empty {
  text-align: center;
  padding: 2rem;
  color: var(--text-dim);
}

/* ============================================================
   PHASE CART SUMMARY
   ============================================================ */

.phase-cart-summary {
  background: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: 0.75rem;
  padding: 1rem;
  margin-bottom: 1.5rem;
}

.phase-cart-empty {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--text-dim);
  font-size: 0.875rem;
  justify-content: center;
  padding: 0.75rem;
}

.phase-cart-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.375rem 0;
  font-size: 0.8125rem;
  color: var(--text-muted);
}

.phase-cart-count {
  font-weight: 600;
  color: var(--text-main);
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border-light);
  margin-bottom: 0.375rem;
}

.phase-cart-discount {
  color: #10b981;
}

.phase-cart-total {
  font-weight: 700;
  color: var(--text-main);
  font-size: 0.9375rem;
  padding-top: 0.5rem;
  border-top: 1px solid var(--border-light);
  margin-top: 0.25rem;
}

.phase-cart-nudge {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  margin-top: 0.75rem;
  padding: 0.625rem 0.75rem;
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent-gold);
}

/* ============================================================
   PRICING PAGE — INDIVIDUAL PHASES LAYOUT
   ============================================================ */

.pricing-cards-container {
  max-width: 40rem;
  margin: 0 auto;
}

.pricing-individual-container {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.pricing-card-full {
  max-width: 28rem;
  margin: 0 auto;
}

.pricing-card-individual {
  max-width: 100%;
}

.pricing-badge-outline {
  background: transparent;
  border: 1px solid var(--accent-gold);
  color: var(--accent-gold);
}

.pricing-btn.disabled {
  opacity: 0.4;
  cursor: not-allowed;
  pointer-events: none;
}

/* ============================================================
   CHECKOUT — PURCHASE SUMMARY
   ============================================================ */

.checkout-purchase-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 1rem;
  background: rgba(245, 158, 11, 0.06);
  border: 1px solid rgba(245, 158, 11, 0.15);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

.checkout-purchase-label {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.checkout-purchase-value {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--accent-gold);
}

/* ============================================================
   PHASE DETAIL CARDS — Pricing Page
   ============================================================ */

.phase-detail-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.phase-detail-card {
  background: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: 0.875rem;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  transition: all 0.25s ease;
  position: relative;
}

.phase-detail-card:hover {
  border-color: rgba(245, 158, 11, 0.2);
  background: var(--bg-card);
}

.phase-detail-card.selected {
  border-color: rgba(245, 158, 11, 0.5);
  background: rgba(245, 158, 11, 0.06);
  box-shadow: 0 0 24px rgba(245, 158, 11, 0.06);
}

.phase-detail-card.locked {
  opacity: 0.55;
}

.phase-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.phase-detail-number {
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.1);
  padding: 0.25rem 0.625rem;
  border-radius: 0.375rem;
}

.phase-detail-selected-badge {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.688rem;
  font-weight: 700;
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  padding: 0.25rem 0.5rem;
  border-radius: 0.375rem;
}

.phase-detail-locked-badge {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.688rem;
  font-weight: 600;
  color: var(--text-dim);
  background: var(--border-light);
  padding: 0.25rem 0.5rem;
  border-radius: 0.375rem;
}

.phase-detail-title {
  font-size: 1.0625rem;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
  margin: 0;
}

.phase-detail-subtitle {
  font-size: 0.75rem;
  color: var(--text-muted);
  line-height: 1.4;
  margin: 0;
}

.phase-detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.phase-detail-meta-item {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.688rem;
  color: var(--text-dim);
}

.phase-detail-desc {
  font-size: 0.8125rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0;
}

/* Learning Outcomes */
.phase-detail-outcomes {
  background: rgba(16, 185, 129, 0.04);
  border: 1px solid rgba(16, 185, 129, 0.1);
  border-radius: 0.5rem;
  padding: 0.75rem;
}

.phase-detail-outcomes-label {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.688rem;
  font-weight: 700;
  color: #10b981;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.5rem;
}

.phase-detail-outcomes-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.phase-detail-outcome-item {
  display: flex;
  align-items: flex-start;
  gap: 0.375rem;
  font-size: 0.75rem;
  color: var(--text-muted);
  line-height: 1.4;
}

.phase-detail-outcome-item svg {
  color: #10b981;
  flex-shrink: 0;
  margin-top: 0.125rem;
}

/* Prerequisite Warning */
.phase-detail-prereq-warning {
  background: rgba(251, 191, 36, 0.06);
  border: 1px solid rgba(251, 191, 36, 0.15);
  border-radius: 0.375rem;
  padding: 0.5rem 0.75rem;
  font-size: 0.688rem;
  color: #fbbf24;
  font-weight: 500;
}

/* Select / Deselect Button */
.phase-detail-btn {
  width: 100%;
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
  margin-top: auto;
}

.phase-detail-btn.select {
  background: rgba(245, 158, 11, 0.1);
  border-color: rgba(245, 158, 11, 0.3);
  color: var(--accent-gold);
}

.phase-detail-btn.select:hover {
  background: rgba(245, 158, 11, 0.18);
  border-color: var(--accent-gold);
}

.phase-detail-btn.deselect {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
  color: #10b981;
}

.phase-detail-btn.deselect:hover {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.3);
  color: #ef4444;
}

.phase-detail-btn.locked {
  background: rgba(148, 163, 184, 0.05);
  border-color: var(--border-light);
  color: var(--text-dim);
  cursor: not-allowed;
}

/* ============================================================
   PRICING PAGE — FULL COURSE PHASE TAGS
   ============================================================ */

.pricing-phases-summary {
  background: rgba(245, 158, 11, 0.04);
  border: 1px solid rgba(245, 158, 11, 0.1);
  border-radius: 0.5rem;
  padding: 0.75rem;
}

.pricing-phases-summary-label {
  display: block;
  font-size: 0.688rem;
  font-weight: 700;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 0.5rem;
}

.pricing-phases-summary-list {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.pricing-phase-tag {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.pricing-phase-tag svg {
  color: #10b981;
  flex-shrink: 0;
}

/* ============================================================
   PRICING PAGE — LAYOUT HELPERS
   ============================================================ */

.pricing-cards-container {
  max-width: 34rem;
  margin: 0 auto;
}

.pricing-individual-container {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  max-width: 64rem;
  margin: 0 auto;
}

.pricing-card-full {
  max-width: 100%;
}

.pricing-cart-sidebar {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 28rem;
  margin: 0 auto;
  width: 100%;
}

.pricing-btn.disabled {
  opacity: 0.4;
  cursor: not-allowed;
  pointer-events: none;
}

.pricing-cta-main {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.875rem 1.5rem;
  font-size: 0.9375rem;
}

/* ============================================================
   PRICING PAGE — RESPONSIVE
   ============================================================ */

@media (max-width: 768px) {
  .phase-detail-grid {
    grid-template-columns: 1fr;
  }

  .pricing-individual-container {
    max-width: 100%;
  }

  .pricing-cart-sidebar {
    max-width: 100%;
  }
}

@media (min-width: 1024px) {
  .pricing-individual-container {
    flex-direction: row;
    align-items: flex-start;
  }

  .phase-detail-grid {
    flex: 1;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  }

  .pricing-cart-sidebar {
    position: sticky;
    top: 6rem;
    width: 300px;
    flex-shrink: 0;
  }
}

/* ============================================================
   PRICING PAGE — FULL COURSE SECTION
   ============================================================ */

.pricing-full-course-section {
  max-width: 34rem;
  margin: 0 auto 3rem;
}

.pricing-card-full {
  position: relative;
}

.pricing-card-full.highlighted {
  border-color: var(--accent-gold);
  box-shadow: 0 0 32px rgba(245, 158, 11, 0.12);
}

.pricing-card-badge-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  margin-bottom: 0.5rem;
}

.pricing-badge-best {
  font-size: 0.625rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #10b981;
  background: rgba(16, 185, 129, 0.12);
  padding: 0.2rem 0.625rem;
  border-radius: 1rem;
}

.pricing-card-cta {
  margin-top: 1.25rem;
}

.pricing-card-cta .pricing-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

/* ============================================================
   PRICING PAGE — ALL PHASES SECTION
   ============================================================ */

.pricing-phases-section {
  max-width: 72rem;
  margin: 0 auto;
}

.pricing-phases-section-header {
  text-align: center;
  margin-bottom: 2rem;
}

.pricing-phases-heading {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 0.5rem;
}

.pricing-phases-subheading {
  font-size: 0.875rem;
  color: var(--text-muted);
}

/* ============================================================
   PHASE DETAIL CARD — PRICE TAG & HEADER RIGHT
   ============================================================ */

.phase-detail-header-right {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.phase-detail-price-tag {
  font-size: 0.9375rem;
  font-weight: 800;
  color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.08);
  padding: 0.2rem 0.625rem;
  border-radius: 0.375rem;
  border: 1px solid rgba(245, 158, 11, 0.2);
}

/* ============================================================
   PRICING PAGE — CART SECTION (Individual Mode)
   ============================================================ */

.pricing-cart-section {
  max-width: 28rem;
  margin: 2rem auto 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.pricing-cart-section .pricing-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem 1.5rem;
  font-size: 0.9375rem;
}

/* ============================================================
   PRICING PAGE — RESPONSIVE
   ============================================================ */

@media (max-width: 768px) {
  .phase-detail-grid {
    grid-template-columns: 1fr;
  }

  .pricing-full-course-section {
    max-width: 100%;
  }

  .pricing-cart-section {
    max-width: 100%;
  }
}

/* ============================================================
   PRICING MODERN — FULL REDESIGN
   ============================================================ */

.pricing-modern {
  max-width: 56rem;
  margin: 0 auto;
  padding: 2rem 1rem 4rem;
}

/* Header */
.pricing-modern-header {
  text-align: center;
  margin-bottom: 3rem;
}

.pricing-modern-eyebrow {
  display: inline-block;
  font-size: 0.6875rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.08);
  padding: 0.3rem 0.875rem;
  border-radius: 2rem;
  margin-bottom: 1rem;
}

.pricing-modern-title {
  font-size: 2rem;
  font-weight: 800;
  color: var(--text-main);
  line-height: 1.2;
  margin: 0 0 0.75rem;
}

.pricing-modern-subtitle {
  font-size: 0.9375rem;
  color: var(--text-muted);
  max-width: 32rem;
  margin: 0 auto;
  line-height: 1.5;
}

/* ============================================================
   FULL COURSE HERO CARD
   ============================================================ */

.pricing-hero-card-wrapper {
  margin-bottom: 3.5rem;
}

.pricing-hero-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: 1.25rem;
  overflow: hidden;
  transition: all 0.3s ease;
}

.pricing-hero-card.active {
  border-color: rgba(245, 158, 11, 0.4);
  box-shadow: 0 0 48px rgba(245, 158, 11, 0.08);
}

.pricing-hero-glow {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(245, 158, 11, 0.06) 0%, transparent 70%);
  pointer-events: none;
}

.pricing-hero-content {
  display: flex;
  gap: 2rem;
  padding: 2rem;
  position: relative;
  z-index: 1;
}

.pricing-hero-left {
  flex: 1;
}

.pricing-hero-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  min-width: 200px;
  text-align: center;
}

.pricing-hero-badges {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}

.pricing-hero-badge-best {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.6875rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  padding: 0.3rem 0.75rem;
  border-radius: 2rem;
}

.pricing-hero-badge-pass {
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.1);
  padding: 0.3rem 0.75rem;
  border-radius: 2rem;
}

.pricing-hero-name {
  font-size: 1.375rem;
  font-weight: 800;
  color: var(--text-main);
  margin: 0 0 0.375rem;
}

.pricing-hero-desc {
  font-size: 0.8125rem;
  color: var(--text-dim);
  margin: 0 0 1.25rem;
}

.pricing-hero-features {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.pricing-hero-features li {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.8125rem;
  color: var(--text-muted);
}

.pricing-hero-features li svg {
  color: var(--accent-gold);
  flex-shrink: 0;
}

.pricing-hero-price-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}

.pricing-hero-save-badge {
  font-size: 0.6875rem;
  font-weight: 800;
  color: #10b981;
  background: rgba(16, 185, 129, 0.12);
  padding: 0.2rem 0.625rem;
  border-radius: 2rem;
  margin-bottom: 0.25rem;
}

.pricing-hero-price {
  display: flex;
  align-items: baseline;
  gap: 0.25rem;
}

.pricing-hero-amount {
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--text-main);
  line-height: 1;
}

.pricing-hero-currency {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--text-muted);
}

.pricing-hero-original {
  font-size: 0.8125rem;
  color: var(--text-dim);
  text-decoration: line-through;
}

.pricing-hero-select-btn {
  width: 100%;
  padding: 0.75rem 1.25rem;
  border-radius: 0.75rem;
  font-size: 0.875rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  border: 2px solid var(--border-medium);
  background: transparent;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.pricing-hero-select-btn:hover {
  border-color: rgba(245, 158, 11, 0.3);
  color: var(--accent-gold);
}

.pricing-hero-select-btn.selected {
  background: rgba(245, 158, 11, 0.12);
  border-color: var(--accent-gold);
  color: var(--accent-gold);
}

/* ============================================================
   ROADMAP SECTION
   ============================================================ */

.pricing-roadmap-section {
  margin-bottom: 2rem;
}

.pricing-roadmap-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.pricing-roadmap-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--text-main);
  margin: 0 0 0.375rem;
}

.pricing-roadmap-subtitle {
  font-size: 0.8125rem;
  color: var(--text-muted);
  margin: 0;
}

.pricing-roadmap-subtitle strong {
  color: var(--accent-gold);
}

.pricing-roadmap-mode-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1.125rem;
  border-radius: 0.625rem;
  font-size: 0.8125rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  border: 2px solid var(--border-medium);
  background: transparent;
  color: var(--text-muted);
  white-space: nowrap;
}

.pricing-roadmap-mode-btn:hover {
  border-color: rgba(245, 158, 11, 0.25);
  color: var(--accent-gold);
}

.pricing-roadmap-mode-btn.active {
  background: rgba(245, 158, 11, 0.1);
  border-color: var(--accent-gold);
  color: var(--accent-gold);
}

/* ============================================================
   TIMELINE
   ============================================================ */

.pricing-timeline {
  position: relative;
  padding-left: 2.5rem;
}

.pricing-timeline-line {
  position: absolute;
  left: 1.125rem;
  top: 0;
  bottom: 0;
  width: 2px;
  background: linear-gradient(to bottom,
    var(--border-medium) 0%,
    var(--border-light) 100%
  );
}

.pricing-timeline-item {
  position: relative;
  margin-bottom: 1rem;
}

.pricing-timeline-marker {
  position: absolute;
  left: -2.5rem;
  top: 1.25rem;
  z-index: 2;
}

.pricing-timeline-dot {
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 50%;
  background: var(--bg-card-solid);
  border: 2px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  color: var(--text-dim);
  font-size: 0.75rem;
  font-weight: 800;
}

.pricing-timeline-item.selected .pricing-timeline-dot {
  background: var(--phase-accent, #f59e0b);
  border-color: var(--phase-accent, #f59e0b);
  color: var(--bg-main);
}

.pricing-timeline-item.expanded .pricing-timeline-dot {
  border-color: var(--phase-accent, #f59e0b);
  box-shadow: 0 0 16px color-mix(in srgb, var(--phase-accent, #f59e0b) 30%, transparent);
}

.pricing-timeline-dot-locked {
  font-size: 0.875rem;
  font-weight: 900;
  color: var(--text-dim);
}

/* Timeline Card */
.pricing-timeline-card {
  background: var(--bg-card);
  border: 1px solid var(--border-light);
  border-radius: 0.875rem;
  overflow: hidden;
  transition: all 0.3s ease;
}

.pricing-timeline-item.selected .pricing-timeline-card {
  border-color: var(--phase-border, rgba(245, 158, 11, 0.2));
  background: var(--phase-bg, rgba(245, 158, 11, 0.04));
}

.pricing-timeline-item.expanded .pricing-timeline-card {
  border-color: var(--phase-border, rgba(245, 158, 11, 0.25));
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
}

.pricing-timeline-item.locked .pricing-timeline-card {
  opacity: 0.6;
}

.pricing-timeline-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1rem 1.25rem;
  background: transparent;
  border: none;
  cursor: pointer;
  width: 100%;
  text-align: left;
  color: inherit;
  transition: background 0.2s ease;
}

.pricing-timeline-card-header:hover {
  background: rgba(255, 255, 255, 0.015);
}

.pricing-timeline-card-header-left {
  flex: 1;
  min-width: 0;
}

.pricing-timeline-phase-label {
  font-size: 0.625rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--phase-accent, #f59e0b);
}

.pricing-timeline-phase-title {
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 0.125rem 0 0.375rem;
  line-height: 1.3;
}

.pricing-timeline-phase-meta {
  display: flex;
  gap: 0.875rem;
  flex-wrap: wrap;
}

.pricing-timeline-phase-meta span {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.6875rem;
  color: var(--text-dim);
}

.pricing-timeline-card-header-right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-shrink: 0;
}

.pricing-timeline-price-badge {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--accent-gold);
  background: rgba(245, 158, 11, 0.08);
  padding: 0.25rem 0.625rem;
  border-radius: 0.375rem;
}

/* Expanded Body */
.pricing-timeline-card-body {
  padding: 0 1.25rem 1.25rem;
  border-top: 1px solid var(--border-light);
  padding-top: 1rem;
}

.pricing-timeline-card-desc {
  font-size: 0.8125rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0 0 1rem;
}

/* Outcomes Grid */
.pricing-timeline-outcomes {
  margin-bottom: 1rem;
}

.pricing-timeline-outcomes-label {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.6875rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--phase-accent, #f59e0b);
  margin-bottom: 0.5rem;
}

.pricing-timeline-outcomes-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.pricing-timeline-outcome-chip {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.75rem;
  color: var(--text-muted);
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-light);
  padding: 0.375rem 0.625rem;
  border-radius: 0.375rem;
}

.pricing-timeline-outcome-chip svg {
  color: var(--phase-accent, #f59e0b);
  flex-shrink: 0;
}

/* Locked Message */
.pricing-timeline-locked-msg {
  font-size: 0.75rem;
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.06);
  border: 1px solid rgba(251, 191, 36, 0.12);
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  margin-bottom: 0.75rem;
}

/* Add to Cart Button */
.pricing-timeline-cart-btn {
  width: 100%;
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  font-size: 0.8125rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border: 1px solid transparent;
}

.pricing-timeline-cart-btn.add {
  background: rgba(245, 158, 11, 0.1);
  border-color: rgba(245, 158, 11, 0.25);
  color: var(--accent-gold);
}

.pricing-timeline-cart-btn.add:hover {
  background: rgba(245, 158, 11, 0.18);
  border-color: var(--accent-gold);
}

.pricing-timeline-cart-btn.remove {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.25);
  color: #10b981;
}

.pricing-timeline-cart-btn.remove:hover {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.25);
  color: #ef4444;
}

.pricing-timeline-cart-btn.disabled {
  background: rgba(148, 163, 184, 0.04);
  border-color: var(--border-light);
  color: var(--text-dim);
  cursor: not-allowed;
}

/* ============================================================
   STICKY CART BAR
   ============================================================ */

.pricing-sticky-cart {
  position: sticky;
  bottom: 1rem;
  z-index: 50;
  margin-top: 2rem;
}

.pricing-sticky-cart-inner {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: var(--bg-card-hover);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  padding: 0.875rem 1.25rem;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}

/* Compact Cart */
.phase-cart-compact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
}

.phase-cart-compact-info {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  color: var(--text-muted);
}

.phase-cart-compact-count {
  font-weight: 700;
  color: var(--text-main);
  font-size: 0.875rem;
}

.phase-cart-compact-discount {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.6875rem;
  font-weight: 700;
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
  padding: 0.15rem 0.5rem;
  border-radius: 1rem;
}

.phase-cart-compact-total {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
}

.phase-cart-compact-label {
  font-size: 0.75rem;
  color: var(--text-dim);
}

.phase-cart-compact-amount {
  font-size: 1.125rem;
  font-weight: 800;
  color: var(--text-main);
}

.pricing-sticky-cta {
  flex-shrink: 0;
  padding: 0.625rem 1.25rem !important;
  font-size: 0.8125rem !important;
}

/* ============================================================
   FULL COURSE CTA WRAPPER
   ============================================================ */

.pricing-full-cta-wrapper {
  text-align: center;
  margin-top: 2rem;
}

.pricing-full-cta-wrapper .pricing-btn-primary {
  display: inline-flex;
}

/* ============================================================
   BUTTON STYLES
   ============================================================ */

.pricing-btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem 2rem;
  border-radius: 0.75rem;
  font-size: 0.9375rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  border: none;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: var(--bg-main);
  text-decoration: none;
}

.pricing-btn-primary:hover {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  box-shadow: 0 4px 20px rgba(245, 158, 11, 0.3);
  transform: translateY(-1px);
}

.pricing-btn-primary.disabled {
  background: var(--border-medium);
  color: var(--text-dim);
  cursor: not-allowed;
  pointer-events: none;
  box-shadow: none;
  transform: none;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 768px) {
  .pricing-modern {
    padding: 1.5rem 0.75rem 3rem;
  }

  .pricing-modern-title {
    font-size: 1.5rem;
  }

  .pricing-hero-content {
    flex-direction: column;
    padding: 1.5rem;
  }

  .pricing-hero-right {
    flex-direction: row;
    justify-content: space-between;
    min-width: auto;
  }

  .pricing-hero-price-block {
    align-items: flex-start;
  }

  .pricing-hero-amount {
    font-size: 2rem;
  }

  .pricing-timeline {
    padding-left: 2rem;
  }

  .pricing-timeline-marker {
    left: -2rem;
  }

  .pricing-timeline-dot {
    width: 1.75rem;
    height: 1.75rem;
  }

  .pricing-sticky-cart-inner {
    flex-direction: column;
    align-items: stretch;
  }

  .phase-cart-compact {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}

/* ============================================================
   COUNTDOWN BANNER — Pricing Page
   ============================================================ */

.countdown-banner {
  border-bottom: 2px solid var(--accent-gold);
  position: sticky;
  top: 0;
  z-index: 45;
}

.countdown-banner-inner {
  max-width: 72rem;
  margin: 0 auto;
  padding: 0.625rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  position: relative;
}

.countdown-banner-icon {
  flex-shrink: 0;
  animation: pulse 2s ease-in-out infinite;
}

.countdown-banner-text {
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.countdown-banner-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--border-light);
}

.countdown-banner-progress-fill {
  height: 100%;
  transition: width 1s linear;
  border-radius: 0 2px 2px 0;
}

/* ============================================================
   CHECKOUT MODAL — Fullscreen Overlay
   ============================================================ */

.checkout-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(2, 6, 23, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.checkout-modal-container {
  background: var(--bg-card-hover);
  border: 1px solid rgba(245, 158, 11, 0.25);
  border-radius: 1.25rem;
  width: 100%;
  max-width: 36rem;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.checkout-modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 0.5rem;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: #ef4444;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  z-index: 5;
}

.checkout-modal-close:hover {
  background: rgba(239, 68, 68, 0.2);
  border-color: rgba(239, 68, 68, 0.4);
}

/* Modal Header */
.checkout-modal-header {
  padding: 1.5rem 1.5rem 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.checkout-modal-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--text-main);
  margin: 0;
}

/* Timer in Modal Header */
.checkout-modal-timer {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.75rem;
  border: 1.5px solid var(--accent-gold);
  border-radius: 2rem;
  font-size: 0.8125rem;
  font-weight: 700;
  font-family: var(--font-mono);
  position: relative;
  overflow: hidden;
}

.checkout-modal-timer-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--border-light);
}

.checkout-modal-timer-bar-fill {
  height: 100%;
  transition: width 1s linear;
}

/* Timer Message Banner */
.checkout-modal-timer-msg {
  margin: 0.75rem 1.5rem;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--accent-gold);
  border-radius: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
}

/* Modal Body */
.checkout-modal-body {
  padding: 1.25rem 1.5rem 1.5rem;
}

/* Purchase Summary in Modal */
.checkout-modal-summary {
  background: rgba(245, 158, 11, 0.04);
  border: 1px solid rgba(245, 158, 11, 0.1);
  border-radius: 0.75rem;
  padding: 1rem;
  margin-bottom: 1.25rem;
}

.checkout-modal-summary-title {
  font-size: 0.75rem;
  font-weight: 800;
  color: var(--accent-gold);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0 0 0.75rem;
}

.checkout-modal-summary-item {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid var(--border-light);
}

.checkout-modal-summary-item:last-child {
  border-bottom: none;
}

.checkout-modal-summary-icon {
  color: var(--accent-gold);
  flex-shrink: 0;
}

.checkout-modal-summary-name {
  flex: 1;
  font-size: 0.8125rem;
  color: var(--text-main);
  font-weight: 500;
}

.checkout-modal-summary-price {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--accent-gold);
  flex-shrink: 0;
}

.checkout-modal-summary-totals {
  margin-top: 0.5rem;
  padding-top: 0.5rem;
  border-top: 1px solid var(--border-light);
}

.checkout-modal-summary-totals .phase-cart-summary {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
}

/* Upgrade Nudge */
.checkout-modal-upgrade-nudge {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 0.75rem;
  padding: 0.625rem 0.75rem;
  background: rgba(16, 185, 129, 0.06);
  border: 1px solid rgba(16, 185, 129, 0.15);
  border-radius: 0.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: #10b981;
}

.checkout-modal-upgrade-nudge svg {
  flex-shrink: 0;
}

/* Modal Section */
.checkout-modal-section {
  margin-bottom: 1.25rem;
}

.checkout-modal-section-label {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-muted);
  margin-bottom: 0.5rem;
}

/* ============================================================
   MODAL RESPONSIVE
   ============================================================ */

@media (max-width: 640px) {
  .checkout-modal-container {
    max-width: 100%;
    border-radius: 1rem 1rem 0 0;
    max-height: 95vh;
  }

  .checkout-modal-header {
    padding: 1.25rem 1rem 0;
  }

  .checkout-modal-body {
    padding: 1rem;
  }

  .checkout-modal-close {
    top: 0.75rem;
    right: 0.75rem;
  }
}

/* ============================================================
   PROFILE PAGE
   ============================================================ */

.profile-page {
  max-width: 64rem;
  margin: 0 auto;
  padding: 2rem 1rem 4rem;
}

/* Profile Header */
.profile-header {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding: 2rem;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1.25rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}

.profile-header-avatar-section {
  flex-shrink: 0;
}

.profile-header-avatar-img {
  width: 5rem;
  height: 5rem;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid var(--accent-gold);
}

.profile-header-avatar-placeholder {
  width: 5rem;
  height: 5rem;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--bg-main);
  border: 3px solid var(--accent-gold);
}

.profile-header-info {
  flex: 1;
  min-width: 200px;
}

.profile-header-name {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text-main);
  margin: 0 0 0.5rem;
}

.profile-header-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 0.75rem;
}

.profile-header-meta-item {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.8125rem;
  color: var(--text-muted);
}

.profile-header-meta-item svg { color: var(--text-dim); }

.profile-header-badges { display: flex; gap: 0.5rem; }

.profile-header-badge {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.75rem;
  border-radius: 2rem;
  font-size: 0.75rem;
  font-weight: 700;
}

.profile-header-badge.enrolled {
  background: rgba(16, 185, 129, 0.1);
  color: #10b981;
  border: 1px solid rgba(16, 185, 129, 0.3);
}

.profile-header-badge.not-enrolled {
  background: var(--border-light);
  color: var(--text-dim);
  border: 1px solid var(--border-medium);
}

.profile-header-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex-shrink: 0;
}

.profile-header-action-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  border-radius: 0.625rem;
  font-size: 0.8125rem;
  font-weight: 700;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.2);
  color: var(--accent-gold);
  cursor: pointer;
  text-decoration: none;
  transition: all 0.2s;
}
.profile-header-action-btn:hover { background: rgba(245, 158, 11, 0.18); border-color: var(--accent-gold); }
.profile-header-action-btn.secondary { background: var(--border-light); border-color: var(--border-medium); color: var(--text-muted); }
.profile-header-action-btn.secondary:hover { background: var(--border-light); color: var(--text-main); }

/* Profile Grid */
.profile-grid { display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start; }

@media (max-width: 900px) {
  .profile-grid { grid-template-columns: 1fr; }
}

.profile-grid-main { display: flex; flex-direction: column; gap: 1.5rem; }
.profile-grid-sidebar { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 6rem; }

/* Profile Card */
.profile-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.15);
  border-radius: 1rem;
  padding: 1.25rem;
}

.profile-card-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 0 0 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--border-light);
}
.profile-card-title svg { color: var(--accent-gold); }

.profile-card-empty { font-size: 0.8125rem; color: var(--text-dim); text-align: center; padding: 1.5rem 0; }
.profile-card-link { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; font-weight: 600; color: var(--accent-gold); text-decoration: none; margin-top: 0.75rem; }
.profile-card-link:hover { text-decoration: underline; }

/* Enrollment Details */
.profile-enrollment-empty { text-align: center; padding: 1rem 0; }
.profile-enrollment-empty p { font-size: 0.8125rem; color: var(--text-dim); margin-bottom: 0.75rem; }

.profile-enrollment-details { display: flex; flex-direction: column; gap: 0.625rem; }
.profile-enrollment-row { display: flex; justify-content: space-between; align-items: center; }
.profile-enrollment-label { font-size: 0.75rem; color: var(--text-dim); }
.profile-enrollment-value { display: flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; font-weight: 600; color: var(--text-main); }
.profile-enrollment-value.highlight { color: var(--accent-gold); font-weight: 700; }

/* Progress Visual */
.profile-progress-visual { display: flex; flex-direction: column; align-items: center; margin-bottom: 1rem; }
.profile-progress-percent { font-size: 1.5rem; font-weight: 800; color: var(--text-main); margin-top: -3.5rem; }

.profile-progress-stats { display: flex; justify-content: center; gap: 2rem; }
.profile-progress-stat { text-align: center; }
.profile-progress-stat-value { display: block; font-size: 1.25rem; font-weight: 700; color: var(--text-main); }
.profile-progress-stat-label { font-size: 0.625rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em; }

/* Phase Progress List */
.profile-phase-list { display: flex; flex-direction: column; gap: 0.75rem; }

.profile-phase-item { padding: 0.75rem; border-radius: 0.5rem; background: var(--surface-secondary); border: 1px solid var(--border-light); }
.profile-phase-item.status-completed { border-color: rgba(16, 185, 129, 0.2); }
.profile-phase-item.status-in-progress { border-color: rgba(245, 158, 11, 0.2); }

.profile-phase-item-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
.profile-phase-item-info { display: flex; align-items: center; gap: 0.5rem; }
.profile-phase-item-number { font-size: 0.625rem; font-weight: 700; color: var(--accent-gold); text-transform: uppercase; }
.profile-phase-item-title { font-size: 0.8125rem; font-weight: 600; color: var(--text-main); }

.profile-phase-item-bar { height: 6px; border-radius: 3px; background: var(--border-light); overflow: hidden; margin-bottom: 0.375rem; }
.profile-phase-item-bar-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, #f59e0b, #fbbf24); transition: width 0.5s ease; }
.profile-phase-item.status-completed .profile-phase-item-bar-fill { background: linear-gradient(90deg, #10b981, #34d399); }

.profile-phase-item-meta { display: flex; justify-content: space-between; font-size: 0.6875rem; color: var(--text-dim); }
.profile-phase-item-status { font-weight: 600; }
.profile-phase-item-status.status-completed { color: #10b981; }
.profile-phase-item-status.status-in-progress { color: #f59e0b; }
.profile-phase-item-status.status-locked { color: var(--text-dim); }

/* Payment History */
.profile-payment-list { display: flex; flex-direction: column; gap: 0.5rem; }

.profile-payment-item { display: flex; align-items: center; justify-content: space-between; padding: 0.625rem 0.75rem; border-radius: 0.5rem; background: var(--surface-secondary); border: 1px solid var(--border-light); }
.profile-payment-item-left { display: flex; align-items: center; gap: 0.625rem; }
.profile-payment-status { font-size: 0.5625rem; font-weight: 700; text-transform: uppercase; padding: 0.15rem 0.5rem; border-radius: 1rem; letter-spacing: 0.05em; }
.profile-payment-status.status-pending { background: rgba(245,158,11,0.12); color: #f59e0b; }
.profile-payment-status.status-approved { background: rgba(16,185,129,0.12); color: #10b981; }
.profile-payment-status.status-rejected { background: rgba(239,68,68,0.12); color: #ef4444; }
.profile-payment-item-info { display: flex; flex-direction: column; }
.profile-payment-item-method { font-size: 0.75rem; font-weight: 600; color: var(--text-main); }
.profile-payment-item-date { font-size: 0.625rem; color: var(--text-dim); }
.profile-payment-item-amount { font-size: 0.8125rem; font-weight: 700; color: var(--accent-gold); }

/* Full Payment List */
.profile-payment-full-list { display: flex; flex-direction: column; gap: 0.75rem; }
.profile-payment-item-full { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; border-radius: 0.75rem; background: var(--glass-bg); border: 1px solid var(--border-light); flex-wrap: wrap; gap: 0.75rem; }
.profile-payment-item-full-left { display: flex; align-items: center; gap: 0.75rem; }
.profile-payment-item-full-method { display: block; font-size: 0.875rem; font-weight: 600; color: var(--text-main); }
.profile-payment-item-full-ref { font-size: 0.6875rem; color: var(--text-dim); font-family: var(--font-mono); }
.profile-payment-item-full-right { text-align: right; }
.profile-payment-item-full-amount { display: block; font-size: 1rem; font-weight: 700; color: var(--accent-gold); }
.profile-payment-item-full-date { font-size: 0.6875rem; color: var(--text-dim); }

/* Quick Actions */
.profile-quick-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }

.profile-quick-action-item {
  display: flex; align-items: center; gap: 0.5rem;
  padding: 0.625rem 0.75rem; border-radius: 0.5rem;
  background: rgba(245, 158, 11, 0.04); border: 1px solid rgba(245, 158, 11, 0.1);
  color: var(--accent-gold); font-size: 0.75rem; font-weight: 600;
  text-decoration: none; cursor: pointer; transition: all 0.2s;
}
.profile-quick-action-item:hover { background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.25); }
.profile-quick-action-icon { flex-shrink: 0; }

/* Account Settings */
.profile-settings-list { display: flex; flex-direction: column; gap: 0.25rem; }

.profile-setting-item {
  display: flex; align-items: center; gap: 0.625rem;
  width: 100%; padding: 0.625rem 0.75rem; border-radius: 0.5rem;
  background: transparent; border: none;
  color: var(--text-muted); font-size: 0.8125rem; font-weight: 500;
  text-decoration: none; cursor: pointer; transition: all 0.15s;
}
.profile-setting-item:hover { background: var(--border-light); color: var(--text-main); }
.profile-setting-icon { flex-shrink: 0; color: var(--text-dim); }
.profile-setting-label { flex: 1; text-align: left; }
.profile-setting-value { font-size: 0.75rem; color: var(--accent-gold); font-weight: 600; }

/* Profile Forms */
.profile-form-container { max-width: 32rem; margin: 0 auto; }
.profile-form-title { font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem; }

.profile-form { display: flex; flex-direction: column; gap: 1rem; }
.profile-back-link { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-muted); text-decoration: none; margin-bottom: 0.5rem; }
.profile-back-link:hover { color: var(--accent-gold); }

.profile-form-error { padding: 0.625rem 0.875rem; border-radius: 0.5rem; background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); color: #ef4444; font-size: 0.75rem; font-weight: 600; }

.profile-form-field { display: flex; flex-direction: column; gap: 0.25rem; }
.profile-form-field label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); }

.profile-form-input {
  width: 100%; padding: 0.625rem 0.875rem; border-radius: 0.625rem;
  background: var(--bg-input); border: 1px solid var(--border-medium);
  color: var(--text-main); font-size: 0.875rem; outline: none; transition: border-color 0.2s;
}
.profile-form-input:focus { border-color: var(--accent-gold); }
.profile-form-input.error { border-color: #ef4444; }

.profile-form-field-error { font-size: 0.6875rem; color: #ef4444; }

.profile-form-submit {
  display: flex; align-items: center; justify-content: center; gap: 0.5rem;
  width: 100%; padding: 0.75rem; border-radius: 0.625rem;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: var(--bg-main); font-size: 0.875rem; font-weight: 700;
  border: none; cursor: pointer; transition: all 0.2s; margin-top: 0.5rem;
}
.profile-form-submit:hover { background: linear-gradient(135deg, #fbbf24, #f59e0b); }
.profile-form-submit:disabled { opacity: 0.5; cursor: not-allowed; }

/* Profile Responsive */
@media (max-width: 640px) {
  .profile-header { flex-direction: column; text-align: center; }
  .profile-header-actions { flex-direction: row; }
  .profile-header-meta { justify-content: center; }
  .profile-header-badges { justify-content: center; }
  .profile-quick-actions { grid-template-columns: 1fr; }
  .profile-grid-sidebar { position: static; }
}

/* ============================================================
   REFERRAL SYSTEM STYLES
   ============================================================ */

/* Referral Page Header */
.referral-page-header {
  margin-bottom: 2rem;
}

.referral-page-title {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--text-main);
  margin: 0 0 0.5rem;
}

.referral-page-subtitle {
  font-size: 0.875rem;
  color: var(--text-muted);
  margin: 0;
}

/* Referral Code Card */
.referral-code-card {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 1rem;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}

.referral-code-card-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
  color: var(--accent-gold);
}

.referral-code-card-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 0;
}

.referral-code-card-subtitle {
  font-size: 0.8125rem;
  color: var(--text-muted);
  margin: 0 0 1rem;
}

/* Code Display */
.referral-code-display {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  background: rgba(245, 158, 11, 0.06);
  border: 1px solid rgba(245, 158, 11, 0.2);
  border-radius: 0.625rem;
  margin-bottom: 0.5rem;
}

.referral-code-text {
  font-size: 1.25rem;
  font-weight: 800;
  font-family: var(--font-mono);
  color: var(--accent-gold);
  letter-spacing: 0.05em;
  flex: 1;
  user-select: all;
}

.referral-code-copy-btn {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.5rem 0.875rem;
  border-radius: 0.5rem;
  background: rgba(245, 158, 11, 0.12);
  border: 1px solid rgba(245, 158, 11, 0.25);
  color: var(--accent-gold);
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.referral-code-copy-btn:hover {
  background: rgba(245, 158, 11, 0.2);
  border-color: var(--accent-gold);
}

/* Link Display */
.referral-link-display {
  padding: 0.5rem 0.75rem;
  background: var(--surface-secondary);
  border: 1px solid var(--border-light);
  border-radius: 0.5rem;
}

.referral-link-text {
  font-size: 0.6875rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
  word-break: break-all;
  user-select: all;
}

/* Referral Share Buttons */
.referral-share-buttons {
  margin-bottom: 1.5rem;
}

.referral-share-label {
  display: block;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-muted);
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.referral-share-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 0.5rem;
}

.referral-share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  padding: 0.625rem 0.75rem;
  border-radius: 0.5rem;
  background: var(--bg-card);
  border: 1px solid var(--border-light);
  color: var(--text-muted);
  font-size: 0.75rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.referral-share-btn:hover {
  background: rgba(245, 158, 11, 0.06);
  border-color: rgba(245, 158, 11, 0.2);
  color: var(--accent-gold);
}

/* Referral Stats Grid */
.referral-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.referral-stat-card {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem;
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.1);
  border-radius: 0.75rem;
}

.referral-stat-icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 0.625rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.referral-stat-info {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
  min-width: 0;
}

.referral-stat-value {
  font-size: 1rem;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.referral-stat-label {
  font-size: 0.625rem;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

/* Tier Progress */
.referral-tier-progress {
  background: var(--glass-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(245, 158, 11, 0.15);
  border-radius: 1rem;
  padding: 1.25rem;
  margin-bottom: 1.5rem;
}

.referral-tier-progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.referral-tier-progress-label {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.referral-tier-progress-current {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--accent-gold);
}

/* Tier Dots */
.referral-tier-dots {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.5rem;
}

.referral-tier-dot {
  width: 1rem;
  height: 1rem;
  border-radius: 50%;
  border: 2px solid transparent;
  transition: all 0.3s ease;
}

.referral-tier-dot.current {
  box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
}

/* Tier Bar */
.referral-tier-bar {
  height: 8px;
  border-radius: 4px;
  background: var(--border-light);
  overflow: hidden;
  margin-bottom: 0.5rem;
}

.referral-tier-bar-fill {
  height: 100%;
  border-radius: 4px;
  transition: width 0.5s ease;
}

.referral-tier-next {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin: 0;
}

.referral-tier-max {
  font-size: 0.75rem;
  color: #10b981;
  font-weight: 600;
  margin: 0;
}

/* Earnings Grid */
.referral-earnings-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.625rem;
}

.referral-earnings-item {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
  padding: 0.625rem;
  background: var(--surface-secondary);
  border-radius: 0.5rem;
}

.referral-earnings-item.highlight {
  background: rgba(245, 158, 11, 0.06);
  border: 1px solid rgba(245, 158, 11, 0.15);
}

.referral-earnings-label {
  font-size: 0.625rem;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.referral-earnings-value {
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--text-main);
}

.referral-earnings-item.highlight .referral-earnings-value {
  color: var(--accent-gold);
}

/* Referral History */
.referral-history-list {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.referral-history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.625rem 0.75rem;
  background: var(--surface-secondary);
  border: 1px solid var(--border-light);
  border-radius: 0.5rem;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.referral-history-left {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.referral-history-status {
  font-size: 0.5625rem;
  font-weight: 700;
  text-transform: uppercase;
  padding: 0.15rem 0.5rem;
  border-radius: 1rem;
  letter-spacing: 0.03em;
}

.referral-history-status.status-completed {
  background: rgba(16, 185, 129, 0.12);
  color: #10b981;
}

.referral-history-status.status-registered {
  background: rgba(245, 158, 11, 0.12);
  color: #f59e0b;
}

.referral-history-status.status-enrolled {
  background: rgba(59, 130, 246, 0.12);
  color: #3b82f6;
}

.referral-history-status.status-expired,
.referral-history-status.status-refunded {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.referral-history-name {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--text-main);
}

.referral-history-right {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.referral-history-credit {
  font-size: 0.75rem;
  font-weight: 600;
  color: #10b981;
}

.referral-history-date {
  font-size: 0.625rem;
  color: var(--text-dim);
}

/* Referral How It Works */
.referral-how-it-works {
  padding: 0;
}

.referral-section-title {
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 0 0 1rem;
}

.referral-steps-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 0.75rem;
}

.referral-step-card {
  padding: 1rem;
  background: var(--surface-secondary);
  border: 1px solid var(--border-light);
  border-radius: 0.625rem;
  text-align: center;
}

.referral-step-icon {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 0.625rem;
  background: rgba(245, 158, 11, 0.08);
  border: 1px solid rgba(245, 158, 11, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-gold);
  margin: 0 auto 0.75rem;
}

.referral-step-title {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--text-main);
  margin: 0 0 0.375rem;
}

.referral-step-desc {
  font-size: 0.6875rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin: 0;
}

/* Referral Registration Banner */
.referral-register-banner {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  padding: 0.75rem 1rem;
  border-radius: 0.625rem;
  margin-bottom: 1rem;
  font-size: 0.8125rem;
}

.referral-register-banner.success {
  background: rgba(16, 185, 129, 0.06);
  border: 1px solid rgba(16, 185, 129, 0.2);
  color: #10b981;
}

.referral-register-banner.loading {
  background: rgba(245, 158, 11, 0.06);
  border: 1px solid rgba(245, 158, 11, 0.15);
  color: var(--text-muted);
}

.referral-register-banner.error {
  background: rgba(239, 68, 68, 0.06);
  border: 1px solid rgba(239, 68, 68, 0.15);
  color: #ef4444;
}

.referral-register-banner-title {
  font-weight: 700;
  margin: 0 0 0.125rem;
}

.referral-register-banner-desc {
  margin: 0;
  font-size: 0.75rem;
  opacity: 0.85;
}

/* ============================================================
   DISCOUNT CODE STYLES
   ============================================================ */

/* Discount Badge */
.discount-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.75rem;
  border-radius: 2rem;
  font-size: 0.75rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
}

.discount-badge-referral {
  background: rgba(16, 185, 129, 0.08);
  border: 1px solid rgba(16, 185, 129, 0.2);
  color: #10b981;
}

.discount-badge-code {
  background: rgba(59, 130, 246, 0.08);
  border: 1px solid rgba(59, 130, 246, 0.2);
  color: #3b82f6;
}

.discount-badge-both {
  background: rgba(139, 92, 246, 0.08);
  border: 1px solid rgba(139, 92, 246, 0.2);
  color: #8b5cf6;
}

.discount-badge-code-name {
  font-family: var(--font-mono);
  font-size: 0.625rem;
  padding: 0.125rem 0.375rem;
  border-radius: 0.25rem;
  background: rgba(0, 0, 0, 0.2);
}

/* Discount Code Input */
.discount-code-input {
  margin-bottom: 0;
}

.discount-code-input-row {
  display: flex;
  gap: 0.5rem;
}

.discount-code-input-field {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: var(--bg-card);
  border: 1px solid var(--border-medium);
  border-radius: 0.5rem;
  transition: border-color 0.2s ease;
}

.discount-code-input-field:focus-within {
  border-color: rgba(245, 158, 11, 0.4);
}

.discount-code-input-icon {
  color: var(--text-dim);
  flex-shrink: 0;
}

.discount-code-input-text {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-main);
  font-size: 0.8125rem;
  font-family: var(--font-mono);
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

.discount-code-input-text::placeholder {
  color: var(--text-dim);
  text-transform: none;
  letter-spacing: normal;
  font-family: var(--font-primary);
}

.discount-code-apply-btn {
  padding: 0.5rem 1rem;
  border-radius: 0.5rem;
  background: rgba(245, 158, 11, 0.1);
  border: 1px solid rgba(245, 158, 11, 0.2);
  color: var(--accent-gold);
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.discount-code-apply-btn:hover:not(:disabled) {
  background: rgba(245, 158, 11, 0.18);
  border-color: var(--accent-gold);
}

.discount-code-apply-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* Discount Code Error */
.discount-code-error {
  font-size: 0.6875rem;
  color: #ef4444;
  margin-top: 0.375rem;
}

/* Discount Code Applied State */
.discount-code-input.applied {
  padding: 0.625rem 0.75rem;
  background: rgba(16, 185, 129, 0.05);
  border: 1px solid rgba(16, 185, 129, 0.2);
  border-radius: 0.5rem;
}

.discount-code-applied-badge {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: #10b981;
  margin-bottom: 0.25rem;
}

.discount-code-applied-amount {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.discount-code-applied-save {
  font-size: 0.6875rem;
  color: var(--text-muted);
}

.discount-code-remove-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 0.25rem;
  background: rgba(239, 68, 68, 0.08);
  border: 1px solid rgba(239, 68, 68, 0.15);
  color: #ef4444;
  cursor: pointer;
  transition: all 0.2s ease;
}

.discount-code-remove-btn:hover {
  background: rgba(239, 68, 68, 0.15);
}

/* Discount Breakdown */
.discount-breakdown {
  padding: 0.25rem 0;
}

.discount-breakdown-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.375rem 0;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.discount-breakdown-row.discount {
  color: #10b981;
}

.discount-breakdown-row.total {
  font-weight: 700;
  color: var(--text-main);
  font-size: 0.875rem;
}

.discount-breakdown-final {
  font-weight: 800;
  color: var(--accent-gold);
  font-size: 0.9375rem;
}

.discount-breakdown-divider {
  height: 1px;
  background: var(--border-light);
  margin: 0.25rem 0;
}

.discount-breakdown-savings {
  margin-top: 0.5rem;
  padding: 0.5rem 0.75rem;
  background: rgba(16, 185, 129, 0.06);
  border: 1px solid rgba(16, 185, 129, 0.12);
  border-radius: 0.375rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: #10b981;
  text-align: center;
}

.discount-breakdown-capped {
  margin-top: 0.375rem;
  padding: 0.375rem 0.625rem;
  background: rgba(251, 191, 36, 0.06);
  border: 1px solid rgba(251, 191, 36, 0.12);
  border-radius: 0.375rem;
  font-size: 0.6875rem;
  color: #fbbf24;
  text-align: center;
}

/* ============================================================
   RESPONSIVE — Referral & Discount
   ============================================================ */

@media (max-width: 640px) {
  .referral-stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .referral-earnings-grid {
    grid-template-columns: 1fr;
  }

  .referral-steps-grid {
    grid-template-columns: 1fr 1fr;
  }

  .referral-share-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 400px) {
  .referral-stats-grid {
    grid-template-columns: 1fr;
  }

  .referral-steps-grid {
    grid-template-columns: 1fr;
  }
}

/* Referral Link Row with Copy Button */
.referral-link-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.referral-link-icon {
  color: var(--text-dim);
  flex-shrink: 0;
}

.referral-link-text {
  flex: 1;
  font-size: 0.6875rem;
  color: var(--text-dim);
  font-family: var(--font-mono);
  word-break: break-all;
  user-select: all;
}

.referral-link-copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 0.375rem;
  background: var(--border-light);
  border: 1px solid var(--border-medium);
  color: var(--text-dim);
  cursor: pointer;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.referral-link-copy-btn:hover {
  background: rgba(245, 158, 11, 0.1);
  border-color: rgba(245, 158, 11, 0.25);
  color: var(--accent-gold);
}