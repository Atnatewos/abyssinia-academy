# ============================================================================
# tools/.merge.env
#
# Purpose:
#   Central configuration for tools/merge.sh (v3+). Every default the script
#   uses lives here. To change behavior project-wide, edit this file — do NOT
#   edit the script. Per-invocation overrides still work via CLI flags.
#
# Loading precedence (first match wins):
#   1. --config <file>       explicit CLI flag
#   2. $MERGE_CONFIG_FILE    environment variable
#   3. ./.merge.env          project-root override
#   4. ./tools/.merge.env    this file (default)
# ============================================================================

# ----------------------------------------------------------------------------
# Default extensions merged when using --dir mode (comma-separated)
# ----------------------------------------------------------------------------
MERGE_DEFAULT_EXTS=".js,.jsx,.ts,.tsx,.mjs,.cjs,.sql,.json,.md,.txt,.css,.scss,.html,.yml,.yaml,.toml,.sh"

# ----------------------------------------------------------------------------
# Default output filename suffix (phase-name is prepended)
# ----------------------------------------------------------------------------
MERGE_DEFAULT_OUT_SUFFIX="_files.txt"

# ----------------------------------------------------------------------------
# Soft warning thresholds (never hard-fails; use --strict for hard failure)
# ----------------------------------------------------------------------------
MERGE_MAX_OUTPUT_BYTES=5242880
MERGE_MAX_OUTPUT_LINES=100000

# ----------------------------------------------------------------------------
# Deny-list (regex, pipe-separated).
# Anything matching is refused unless --allow-protected is passed.
# ----------------------------------------------------------------------------
MERGE_DENY_PATTERNS="(^|/)\.env(\.|$)|(^|/)node_modules/|(^|/)\.next/|(^|/)dist/|(^|/)build/|(^|/)\.git/|(^|/)package-lock\.json$|(^|/)pnpm-lock\.yaml$|(^|/)yarn\.lock$|(^|/)\.DS_Store$|(^|/)\.turbo/|(^|/)coverage/|(^|/)\.nyc_output/"